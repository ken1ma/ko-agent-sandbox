# Use this .ko-agent-sandbox/egress/rule with --egress=deny-unless-allowed to permit only the
# model provider's default rules. Other dependency downloads and documentation reads will fail.
# Under allow-unless-denied, unlisted public hosts remain readable.
# Choose the launched agent's provider: anthropic for claude, openai for codex, google for agy,
# aws for kiro-cli, github for copilot.
deny defaults
allow model-provider anthropic
