# Allow `pulumi up` against AWS in N. Virginia.

# UNCOMMENT AND EDIT THESE LINES
# The bucket name and prefix must match backend.url in Pulumi.yaml,
# such as s3://my-bucket-for-pulumi-state/pulumi?awssdk=v2
# Add POST to the first line when a state file reaches 16 MiB, where pulumi switches to a multipart upload.
#allow https://my-bucket-for-pulumi-state.s3.us-east-1.amazonaws.com/pulumi/      read method=PUT,DELETE
#allow https://my-bucket-for-pulumi-state.s3.us-east-1.amazonaws.com/             read  # pulumi lists at the root

# Launch the sandbox with --env-aws-cred[=<profile>]
# Forward a read-only credential when only `pulumi preview` is run.

# UNCOMMENT AND EDIT THESE LINES IF NEEDED
# S3 and ECR hosts carry your bucket name and account id
#allow https://my-bucket.s3.us-east-1.amazonaws.com/              read method=POST,PUT,DELETE        # S3 bucket
#allow https://123456789012.dkr.ecr.us-east-1.amazonaws.com/      read method=POST,PUT,PATCH,DELETE  # Image push

