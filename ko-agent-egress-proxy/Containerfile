# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
ARG IMG_TAG_VER
FROM debian-coursier:${IMG_TAG_VER} AS build

# This layer precedes the application COPY, so the named build-stage cache keeps the toolchain when the proxy's
# sources change. Only the native compilation repeats.
# The GraalVM release bundles its own JDK, on which sbt and native-image run, so its JDK version need not match
# debian-temurin's Temurin. GRAALVM_ARCHIVE_VERSION is the version part of the release's archive names: the GraalVM
# release (25i5, 25 Innovation 5) and its JDK version.
ARG GRAALVM_RELEASE=graal-25.5.5.0.3
ARG GRAALVM_ARCHIVE_VERSION=25i5-25.0.5.0.3

# Coursier cannot install this GraalVM release. Even its latest unpublished index stops at GraalVM Community 25.0.2,
# so this command fails:
#   cs java --jvm graalvm-community:25.0.5.0.3 --jvm-index \
#     https://raw.githubusercontent.com/coursier/jvm-index/refs/heads/create-pull-request/patch/index.json

RUN set -euxo pipefail; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        gcc \
        zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*; \
    case "$(uname -m)" in \
        aarch64) \
            GRAALVM_ARCH=aarch64; \
            GRAALVM_SHA256=41741c0650ae7564a78335f9e4fc353a902e6ff1d4140f2e4fabd1c55d5cce66 \
            ;; \
        x86_64) \
            GRAALVM_ARCH=x64; \
            GRAALVM_SHA256=c6438dee6c3ade2220d40b7ccdcad24b512d30e233e61bb4fc70519522de34ef \
            ;; \
        *) \
            echo "Unsupported architecture: $(uname -m)" >&2; \
            exit 1 \
            ;; \
    esac; \
    GRAALVM_ARCHIVE="graalvm-community-jdk-${GRAALVM_ARCHIVE_VERSION}"; \
    GRAALVM_ARCHIVE="${GRAALVM_ARCHIVE}_linux-${GRAALVM_ARCH}_bin.tar.gz"; \
    GRAALVM_BASE_URL="https://github.com/graalvm/graalvm-ce-builds/releases/download/${GRAALVM_RELEASE}"; \
    GRAALVM_URL="${GRAALVM_BASE_URL}/${GRAALVM_ARCHIVE}"; \
    curl -fsSL "$GRAALVM_URL" -o "/tmp/$GRAALVM_ARCHIVE"; \
    printf '%s  %s\n' "$GRAALVM_SHA256" "/tmp/$GRAALVM_ARCHIVE" | sha256sum -c -; \
    install -d -m 0755 /opt/graalvm; \
    tar -xzf "/tmp/$GRAALVM_ARCHIVE" --strip-components=1 -C /opt/graalvm; \
    rm "/tmp/$GRAALVM_ARCHIVE"; \
    test -x /opt/graalvm/bin/native-image

ENV JAVA_HOME=/opt/graalvm
ENV PATH="/opt/graalvm/bin:$PATH"

# Build as nonroot: cs setup's cache is under /home/nonroot, and a build as root would fill a second, cold cache
# every time.
RUN set -euxo pipefail; \
    install -d -o nonroot -g nonroot /build
USER nonroot

COPY --chown=nonroot:nonroot app /build/app
WORKDIR /build/app

RUN set -euxo pipefail; \
    sbt -batch dist; \
    # -J-Xmx caps the builder's heap. In a container, the default heap is 85% of the machine's *total* memory. \
    # Running sandbox sessions hold part of that memory, so the default exceeds the free memory, and every \
    # session pays for the excess. \
    # The cap sits just above the measured heap peak of 1.39 GiB on aarch64. x64 compiles different code and \
    # trips first if the peak grows. \
    #   - The context ships bundled in the launcher jar, so users compile only sources a developer already \
    #     built. Growth fails the developer's own build. \
    #   - A roomier cap would hide growth in GC time that nobody reads. \
    # -R:MaxHeapSize caps the proxy's own heap: bodies pass through fixed buffers instead of accumulating in \
    # the managed heap. \
    native-image \
        -J-Xmx1536m \
        -R:MaxHeapSize=64m \
        -o /build/ko-agent-egress-proxy \
        -jar target/dist/ko-agent-egress-proxy.jar

# The build stage creates the mount point for the leaf certificate and key, because distroless has no shell to run
# mkdir. A mount point in the image shows where the leaf goes and does not depend on podman's --read-only behavior.
RUN set -euxo pipefail; \
    install -d -o nonroot -g nonroot -m 0755 /build/tls

# The build stage creates the audit log's mount point for the same reasons. The log file ships empty, so the image
# also runs on its own and logs to stderr.
RUN set -euxo pipefail; \
    install -d -o nonroot -g nonroot -m 0755 /build/var-log; \
    install -o nonroot -g nonroot -m 0644 /dev/null /build/var-log/proxy.log


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
#
# The proxy enforces the egress rules, so its image holds nothing an attacker could use. Distroless has no shell,
# package manager, interpreter or JVM, so no ad-hoc command runs inside the container.
# - The image has no HEALTHCHECK as a result. The log shows liveness (--egress-log).
# - `nonroot` is a mutable tag that resolves to uid 65532.
#
# debian13 follows debian-temurin's DEBIAN_VERSION: the build stage links the executable against that release's
# glibc, which this base must provide.
FROM gcr.io/distroless/base-debian13:nonroot

LABEL org.opencontainers.image.title="ko-agent-egress-proxy"
LABEL org.opencontainers.image.description="CONNECT-only egress proxy enforcing a ko-agent-sandbox workspace's rules"
LABEL org.opencontainers.image.base.name="gcr.io/distroless/base-debian13:nonroot"

# BUNDLE_ID is the digest of this directory as the launcher bundled it (LauncherImages.contextSourceId).
# A launch recomputes the digest from its own jar and refuses a default-named image that another jar built.
# This label locks the image to the launcher that bundled its sources (LauncherImages.bundleMismatch).
ARG BUNDLE_ID
LABEL ko-agent-sandbox.bundle=${BUNDLE_ID}

# The image holds one native executable. The Debian of the build stage matches this Debian runtime, and each image
# architecture compiles its own executable.
COPY --from=build /build/ko-agent-egress-proxy /usr/local/bin/ko-agent-egress-proxy

# The launch mounts the leaf certificate and its key here for TLS inspection (SECURITY.md, "Who holds the CA key").
# With no variable set, the proxy runs uninspected, so the image also runs on its own.
# The CA's key never enters this container.
COPY --from=build /build/tls /etc/ko-agent-egress-proxy

# The proxy writes the per-run audit log here. The log is a bind-mounted host file that outlives the container.
COPY --from=build /build/var-log /var/log/ko-agent-egress-proxy

# EXPOSE only documents the port. The launch publishes no port, so a workstation process cannot borrow the
# sandbox's egress rules.
EXPOSE 3128

# The base already runs as 65532. This line restates the uid as a security property of this image.
USER 65532:65532

ENTRYPOINT ["/usr/local/bin/ko-agent-egress-proxy"]
