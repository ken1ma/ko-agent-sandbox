# The launcher's default file rules: workspace files a program on your host runs a command from
# when you start an agent in the workspace, commit, open it in an editor, enter its directory, or
# reopen it in a Dev Container, and the file git-lfs on your host takes its server from when you
# check out or push. A session cannot change them at any depth, except inside node_modules (the
# last line). Build files, scripts and package.json stay writable, because you run those yourself.
#
# - A file is listed unless a command you run for another purpose rewrites it, the way
#   `npm install` rewrites package-lock.json, or its program asks you again when it changes, as
#   direnv does for .envrc (doc/file-rule-example/direnv/rule lists it).
# - A command meant to change a listed file, such as `pre-commit autoupdate`, `mise use` or
#   `claude mcp add --scope project`, runs on the host, as `--update` does for the agents.
# - Editors are assumed to run on the host. A workspace whose editor or agent maintains a listed
#   file in the sandbox adds a `writable` line for it to .ko-agent-sandbox/file/rule.
#
# The reasons, source by source: doc/file-rules.md, "Why these files".

# Agents on the host: hooks, helper commands and the MCP servers their files in the workspace name.
read-only .claude/settings.json         # Claude Code, Copilot CLI
read-only .claude/settings.local.json
read-only .claude/skills                # Claude Code: hooks and !`command` lines
read-only .claude/agents                # Claude Code, Copilot CLI
read-only .claude/commands
read-only .mcp.json                     # Claude Code, Copilot CLI
read-only .codex/config.toml            # Codex
read-only .gemini/settings.json         # Gemini CLI
read-only .github/hooks                 # Copilot CLI
read-only .github/copilot/settings.json
read-only .github/copilot/settings.local.json
read-only .github/mcp.json
read-only .github/lsp.json
read-only .github/extensions
read-only .github/agents
read-only .agents/hooks.json            # Antigravity
read-only .agents/mcp_config.json
read-only .agents/plugins
read-only .kiro/hooks                   # Kiro
read-only .kiro/agents
read-only .kiro/settings/mcp.json
read-only .opencode                     # OpenCode: plugins, tools and commands it loads
read-only opencode.json
read-only opencode.jsonc

# Git hook managers: the hook installed in .git runs what these name at each commit.
read-only .husky
read-only .pre-commit-config.yaml
read-only lefthook.*                    # .config/lefthook.* too: a name matches at any depth
read-only .lefthook.*
read-only lefthook-local.*
read-only .lefthook-local.*

# Editors: configuration a trusted folder runs.
read-only .vscode                       # VS Code, and Zed for its tasks and launch files
read-only *.code-workspace
read-only .vs                           # Visual Studio
read-only tasks.vs.json
read-only launch.vs.json
read-only .idea                         # IntelliJ IDEA
read-only .cursor/hooks.json            # Cursor
read-only .cursor/mcp.json
read-only .windsurf/hooks.json          # Windsurf
read-only .devin/hooks.json
read-only .zed                          # Zed

# Dev Containers: initializeCommand runs on the host.
read-only .devcontainer
read-only .devcontainer.json

# mise: [hooks] enter runs when you enter the directory, and a file stays trusted by path.
read-only mise.toml                     # .config/mise.toml too: a name matches at any depth
read-only .mise.toml
read-only mise.*.toml
read-only .mise.*.toml
read-only mise
read-only .mise
read-only .tool-versions                # its templates can run commands
read-only .miserc.toml                  # which configuration files load
read-only .miserc.*.toml
read-only miserc.toml                   # .config/miserc.toml, without pinning every .config

# Git LFS: the server a checkout downloads from and a push uploads to.
read-only .lfsconfig

# Last, so it decides inside node_modules: npm installs packages that carry listed names.
writable node_modules
