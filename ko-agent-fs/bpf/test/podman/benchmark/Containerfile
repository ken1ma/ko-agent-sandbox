# ---------------------------------------------------------------------------
# Build the benchmark suite of ko-agent-fs/bpf/doc/evidence.md: the launcher's controller,
# read-back and fixture of ko-agent-fs/bpf/ over its policy program, and the counters reader
# ---------------------------------------------------------------------------
#
# Benchmark.scala builds this on the host, from a context it assembles out of the files sources.txt
# lists. It then extracts /out from the image inside the podman machine, as the other suites'
# drivers do. The measured containers run the sandbox image itself, not this one: the suite compares
# three stacks over one tree, and the image must be the one a session runs.
#
# vmlinux.h is generated from the kernel this build runs on: the machine's kernel, which the
# programs attach to. The binaries are static, so they run in the machine as they are.

# Debian 13 (trixie), matching the rest of this project's images.
FROM docker.io/library/debian:trixie-slim AS build

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        clang-19 llvm-19 bpftool libbpf-dev libelf-dev zlib1g-dev libzstd-dev linux-libc-dev libc6-dev; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY policy.bpf.c records.h backend.h loader.h controller.c readback.c fixture.c stats.c ./

# The step below reads the kernel's BTF, which podman does not see as a build input. A cached layer
# would then outlive a kernel upgrade, so the driver passes the machine's `uname -r` here as part of
# the cache key.
ARG BUILD_KERNEL=unknown

# The user-space binaries take the hardening of ko-agent-fs/bpf/Containerfile, so the suite runs them
# as they ship.
RUN set -eux; \
    mkdir -p /out; \
    test "$(uname -r)" = "$BUILD_KERNEL"; \
    test -r /sys/kernel/btf/vmlinux; \
    bpftool btf dump file /sys/kernel/btf/vmlinux format c > vmlinux.h; \
    clang-19 --version | head -1 > /out/clang-version.txt; \
    clang-19 -O2 -g -target bpf -mcpu=v3 -Wall -Wno-missing-declarations -Werror \
        -c policy.bpf.c -o /out/policy.bpf.o; \
    sha256sum /out/policy.bpf.o >> /out/objects.sha256; \
    case "$(uname -m)" in \
        aarch64) branch=-mbranch-protection=standard ;; \
        x86_64) branch=-fcf-protection ;; \
        *) echo "no branch protection flag for $(uname -m)" >&2; exit 1 ;; \
    esac; \
    hardening="-D_FORTIFY_SOURCE=3 -fstack-protector-strong -fstack-clash-protection $branch -static-pie"; \
    clang-19 -O2 -Wall -Werror $hardening -I. -o /out/controller controller.c -lbpf -lelf -lz -lzstd; \
    clang-19 -O2 -Wall -Werror $hardening -I. -o /out/readback readback.c -lbpf -lelf -lz -lzstd; \
    clang-19 -O2 -Wall -Werror $hardening -I. -o /out/fixture fixture.c; \
    clang-19 -O2 -Wall -Werror $hardening -I. -o /out/stats stats.c -lbpf -lelf -lz -lzstd; \
    for bin in controller readback fixture stats; do \
        ldd /out/$bin 2>&1 | grep -q "statically linked\|not a dynamic executable"; \
    done; \
    uname -r > /out/build-kernel.txt

# What the driver extracts; nothing runs from this image.
FROM docker.io/library/debian:trixie-slim

COPY --from=build /out /out
