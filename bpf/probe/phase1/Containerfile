# ---------------------------------------------------------------------------
# Build the Phase 1 probe of doc/plan-bpf-lsm-cgroup.md
# ---------------------------------------------------------------------------
#
# phase1.sh builds this on the host and extracts /out from the image inside the podman machine,
# as the launcher extracts the filter (KoAgentFs.scala, koAgentFsInstallCommands). The machine
# installs no toolchain: clang and libbpf live here, and the plan pins the compiler because the
# instruction count and stack depth the verifier judges are its output ("Environment evidence").
#
# vmlinux.h is generated from the kernel this build runs on. A `podman build` on macOS or Windows
# runs in the podman machine, so that is the machine's kernel, the one the programs attach to;
# the CO-RE relocations in the object would also carry it to the other machine's kernel.
#
# The controller is static: it runs in the machine, whose libc is not this image's.

# Debian 13 (trixie), matching the rest of this project's images.
FROM docker.io/library/debian:trixie-slim AS build

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        clang-19 llvm-19 bpftool libbpf-dev libelf-dev zlib1g-dev libzstd-dev linux-libc-dev; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY lsm_probe.bpf.c controller.c ./

# The kernel whose BTF the step below reads is not a build input podman sees, so a cached layer
# would outlive a kernel upgrade; the driver passes the machine's `uname -r` here to key the cache.
ARG BUILD_KERNEL=unknown

RUN set -eux; \
    mkdir -p /out; \
    test "$(uname -r)" = "$BUILD_KERNEL"; \
    test -r /sys/kernel/btf/vmlinux; \
    bpftool btf dump file /sys/kernel/btf/vmlinux format c > vmlinux.h; \
    clang-19 --version | head -1 > /out/clang-version.txt; \
    clang-19 -O2 -g -target bpf -mcpu=v3 -Wall -Wno-missing-declarations -Werror \
        -c lsm_probe.bpf.c -o /out/lsm_probe.bpf.o; \
    llvm-objdump-19 -d --no-show-raw-insn /out/lsm_probe.bpf.o > /out/lsm_probe.bpf.asm; \
    sha256sum /out/lsm_probe.bpf.o > /out/lsm_probe.bpf.o.sha256; \
    clang-19 -O2 -Wall -Werror -static -o /out/controller controller.c -lbpf -lelf -lz -lzstd; \
    ldd /out/controller 2>&1 | grep -q "statically linked\|not a dynamic executable"; \
    uname -r > /out/build-kernel.txt

FROM scratch
COPY --from=build /out /out
