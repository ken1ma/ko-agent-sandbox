# ---------------------------------------------------------------------------
# Build the Phase 5 probe of doc/plan-bpf-lsm-cgroup.md: Phase 4's controller, read-back and fixture
# over Phase 3's policy program, and the counters reader beside them
# ---------------------------------------------------------------------------
#
# Phase5.scala builds this on the host from a context it assembles out of the files sources.txt
# lists, then extracts /out from the image inside the podman machine, as the earlier phases'
# drivers do. The measured containers run the sandbox image itself, not this one: the phase compares
# three stacks over one tree, and the image must be the one a session runs.
#
# vmlinux.h is generated from the kernel this build runs on, the machine's, the one the programs
# attach to. The binaries are static, so they run in the machine as they are.

# Debian 13 (trixie), matching the rest of this project's images.
FROM docker.io/library/debian:trixie-slim AS build

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        clang-19 llvm-19 bpftool libbpf-dev libelf-dev zlib1g-dev libzstd-dev linux-libc-dev libc6-dev; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY policy.bpf.c records.h probe.h controller.c readback.c fixture.c stats.c ./

# The kernel whose BTF the step below reads is not a build input podman sees, so a cached layer
# would outlive a kernel upgrade; the driver passes the machine's `uname -r` here to key the cache.
ARG BUILD_KERNEL=unknown

RUN set -eux; \
    mkdir -p /out; \
    test "$(uname -r)" = "$BUILD_KERNEL"; \
    test -r /sys/kernel/btf/vmlinux; \
    bpftool btf dump file /sys/kernel/btf/vmlinux format c > vmlinux.h; \
    clang-19 --version | head -1 > /out/clang-version.txt; \
    clang-19 -O2 -g -target bpf -mcpu=v3 -Wall -Wno-missing-declarations -Werror \
        -c policy.bpf.c -o /out/policy.bpf.o; \
    sha256sum /out/policy.bpf.o >> /out/objects.sha256; \
    clang-19 -O2 -Wall -Werror -static -I. -o /out/controller controller.c -lbpf -lelf -lz -lzstd; \
    clang-19 -O2 -Wall -Werror -static -I. -o /out/readback readback.c -lbpf -lelf -lz -lzstd; \
    clang-19 -O2 -Wall -Werror -static -I. -o /out/fixture fixture.c; \
    clang-19 -O2 -Wall -Werror -static -I. -o /out/stats stats.c -lbpf -lelf -lz -lzstd; \
    for bin in controller readback fixture stats; do \
        ldd /out/$bin 2>&1 | grep -q "statically linked\|not a dynamic executable"; \
    done; \
    uname -r > /out/build-kernel.txt

# What the driver extracts; nothing runs from this image.
FROM docker.io/library/debian:trixie-slim

COPY --from=build /out /out
