# Debian 13 (trixie), which matches the distroless java25-debian13 runtime base.
ARG DEBIAN_VERSION=13.7
FROM docker.io/library/debian:${DEBIAN_VERSION}-slim

# An exact Temurin build rather than a release prefix such as 25.0.5. The build cache keeps the install's layer while
# this value is unchanged, and --update does not rebuild this image. So a prefix would take an extra release of the same
# update, such as 25.0.4.1, only when the cache happened to miss, and machines with the same value could hold different
# builds.
ARG TEMURIN_VERSION=25.0.5.0.0+8

# Podman 5.2.0+ (Buildah 1.37.0+) populates TARGETARCH.
ARG TARGETARCH

# Debian recommends C.UTF-8. musl recognizes that spelling, while bionic rejects the glibc-normalized C.utf8.
ENV LANG=C.UTF-8

# The variable avoids `debconf: unable to initialize frontend: Dialog` and similar warnings.
# It is `ENV` rather than `ARG`, so descendant images and containers inherit it.
ENV DEBIAN_FRONTEND=noninteractive

# The uid and gid that distroless :nonroot uses; USER still decides who runs.
# `--no-log-init`: otherwise uid 65532 would leave a large sparse faillog.
#
# The commands use `;`, not `&&`, throughout, because `set -e` already sequences them. Debian 13's dash supports
# pipefail.
RUN set -euxo pipefail; \
    groupadd --gid 65532 nonroot; \
    useradd \
        --uid 65532 \
        --gid 65532 \
        --create-home \
        --shell /sbin/nologin \
        --no-log-init \
        nonroot


# Temurin (Java)
#
# APT on Debian 13 can consume an ASCII-armored OpenPGP key directly.

RUN set -euxo pipefail; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        curl \
        # avoids `curl: (77) error setting certificate file: /etc/ssl/certs/ca-certificates.crt`
        ca-certificates \
        # jlink --strip-debug needs objcopy (https://github.com/docker-library/openjdk/issues/351).
        # See https://github.com/adoptium/containers/blob/main/25/jdk/ubuntu/resolute/Dockerfile
        binutils; \
    rm -rf /var/lib/apt/lists/*

# `%%.*` (25.0.5.0.0+8 -> 25) is not in the Dockerfile spec, but podman accepts it since 5.2.0. The closing `test -x`
# fails the build if podman ever stops accepting it.
ENV JAVA_HOME=/usr/lib/jvm/temurin-${TEMURIN_VERSION%%.*}-jdk-${TARGETARCH}

RUN set -euxo pipefail; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
        -o /etc/apt/keyrings/adoptium.asc; \
    chmod 0644 /etc/apt/keyrings/adoptium.asc; \
    printf '%s\n' \
        'Types: deb' \
        'URIs: https://packages.adoptium.net/artifactory/deb' \
        'Suites: trixie' \
        'Components: main' \
        'Signed-By: /etc/apt/keyrings/adoptium.asc 3B04D753C9050D9A5D343F39843C48A565F8F04B' \
        > /etc/apt/sources.list.d/adoptium.sources; \
    apt-get update; \
    TEMURIN_DEB_PACKAGE="temurin-${TEMURIN_VERSION%%.*}-jdk"; \
    # Select the latest Debian revision of exactly the requested Temurin build.
    # `dpkg --compare-versions` is authoritative, but `sort -V` suffices for Adoptium's version format.
    TEMURIN_DEB_VERSION="$( \
        apt-cache madison "$TEMURIN_DEB_PACKAGE" \
        | awk -v v="$TEMURIN_VERSION" 'index($3, v "-") == 1 { print $3 }' \
        | sort -V \
        | tail -n 1 \
    )"; \
    if [ -z "$TEMURIN_DEB_VERSION" ]; then \
        echo "Adoptium has no $TEMURIN_DEB_PACKAGE for Temurin build $TEMURIN_VERSION." \
            "Set TEMURIN_VERSION to a build these package versions begin with:" >&2; \
        apt-cache madison "$TEMURIN_DEB_PACKAGE" | awk '{ print "  " $3 }' >&2; \
        exit 1; \
    fi; \
    apt-get install -y --no-install-recommends "$TEMURIN_DEB_PACKAGE=$TEMURIN_DEB_VERSION"; \
    rm -rf /var/lib/apt/lists/*; \
    test -x "$JAVA_HOME/bin/java"

# The image's tag names the major versions alone (LauncherImages.ImgTagVersion), so these labels show the two full
# versions above. The images built on this one inherit the labels.
# The labels follow the last RUN, because podman reuses a cached LABEL step whose ARG value changed (buildah #5501).
# A changed DEBIAN_VERSION changes FROM, and a changed TEMURIN_VERSION changes the RUN above. Either change misses
# the cache, along with every step after it.
ARG DEBIAN_VERSION
LABEL debian-temurin.debian-version=${DEBIAN_VERSION}
LABEL debian-temurin.temurin-version=${TEMURIN_VERSION}
