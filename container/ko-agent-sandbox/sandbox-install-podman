#!/bin/sh
# Install a rootless podman in this session, configured for the one shape that works here.
#
#     sandbox-install-podman
#     export XDG_RUNTIME_DIR=/tmp/xdg          # in every shell that runs podman
#     podman run --rm docker.io/library/alpine:latest echo hello
#
# Refuses unless the session was launched with KO_AGENT_SANDBOX_NESTING=same-uid: at the default
# `none` the container deliberately lacks what a runtime needs, every pull dies at layer unpack,
# and the failure reads like a podman bug rather than the decision it is.
#
# Everything lands under $HOME and dies with the session, so this runs again next time.
set -eu

nesting=${KO_AGENT_SANDBOX_NESTING:-none}
if [ "$nesting" != same-uid ]; then
    echo "${0##*/}: this session is KO_AGENT_SANDBOX_NESTING=$nesting; a container runtime" >&2
    echo "  runs only under same-uid, which is the user's choice at launch. Run the service as" >&2
    echo "  an ordinary process instead, or ask them to relaunch (AGENTS-SANDBOX.md)." >&2
    exit 1
fi

sandbox-apt-get update
# netavark is unused under host networking, but podman refuses to start without the binary.
sandbox-apt-get install podman

mkdir -p /tmp/xdg "$HOME/.config/containers"

# netns/utsns host: an inner container shares this sandbox's network namespace and hostname,
# because creating either of its own needs a capability this sandbox does not carry.
# cgroups disabled: nothing delegates a cgroup here, so per-container limits are unavailable.
cat > "$HOME/.config/containers/containers.conf" <<EOF
[containers]
netns = "host"
utsns = "host"
cgroups = "disabled"
[engine]
events_logger = "file"
helper_binaries_dir = ["$HOME/.local/deb/usr/lib/podman", "$HOME/.local/deb/usr/bin"]
[engine.runtimes]
# via the ~/.local/bin wrapper: helper_binaries_dir would resolve the unwrapped crun,
# which cannot find its own libraries
crun = ["$HOME/.local/bin/crun"]
EOF

printf '{ "default": [ { "type": "insecureAcceptAnything" } ] }\n' \
    > "$HOME/.config/containers/policy.json"
printf 'unqualified-search-registries = ["docker.io"]\n' \
    > "$HOME/.config/containers/registries.conf"
printf '[storage]\ndriver = "overlay"\n[storage.options]\nignore_chown_errors = "true"\n' \
    > "$HOME/.config/containers/storage.conf"

echo "podman configured. Set XDG_RUNTIME_DIR=/tmp/xdg in every shell that runs it."
