#!/bin/sh
#
# The image's ENTRYPOINT. Seeds ~/persistent-volume one agent directory at a time, only where the
# directory is absent: a fresh volume receives every seed, one created by an older image only the
# directories it lacks, and a directory that exists is agent state, never touched. Podman's own
# copy-up into an empty volume would cover only the first case.
#
# Each directory is published by one rename, so a session racing another on the same volume sees
# either nothing or the whole seed; the loser's rename fails on the winner's directory, which is
# the outcome wanted, and its staging directory is removed.
#
# Then each agent's trust entry for the project, keyed by the path it is mounted at: the working
# directory, which the launcher sets to the project's own path. Per launch rather than seeded,
# because the entry is per project while a seeded directory is never touched again and the volume
# may be shared (KO_AGENT_SANDBOX_PERSISTENT_VOLUME). Merged into the agent's own file, which the
# agent rewrites: user state, in the volume. The keys are the agents' internals and may change
# between releases; an entry that cannot be written is said, and the agent then asks.
#
# Then the machine's health, read from here rather than by the launcher: /proc/meminfo and
# /proc/pressure are the VM's own, not the container's, and the same read serves a podman machine
# and a native Linux host. It is a warning at the last moment the terminal is still this script's,
# held on screen because the agent's TUI clears it; the launcher's SESSION_START setting is
# honoured, and a launch with no terminal is never held.
set -eu

seed=$SANDBOX_VOLUME_SEED
volume=$HOME/persistent-volume
# The tests substitute a fixture for /proc; nothing else sets it.
proc=${SANDBOX_PROC:-/proc}

# No $volume, no seeding: a session always has the directory — the image ships nonroot's, and the
# launcher mounts the named volume over it — so its absence means a container run by hand, likely
# as root, whose $HOME holds none. Seeding would only abort on the mktemp under set -eu and take
# the command down with it, over state such a container was never going to keep.
if [ -d "$volume" ]; then
    for entry in "$seed"/*; do
        name=$(basename "$entry")
        [ -e "$volume/$name" ] && continue
        staging=$(mktemp -d "$volume/.seeding-$name.XXXXXX")
        # Do not preserve metadata: on SELinux, the image seed carries this container's private MCS
        # categories. Copying that context into the shared volume makes the directory unreadable to
        # every later session. The staging directory and new children inherit the volume's shared
        # label.
        cp -R "$entry/." "$staging/"
        mv -T "$staging" "$volume/$name" 2>/dev/null || { rm -rf "$staging"; [ -e "$volume/$name" ]; }
    done
fi

# A container run by hand starts at /, which is no project.
project=$PWD
trust_warning() { echo "warning: could not record $project as trusted in $1; $2 may ask" >&2; }
# Rewrite a JSON file through a jq filter over $project, creating an empty object where the agent
# has written none yet. Replaced whole by rename, so a session or agent reading it sees one
# version or the other. Copilot writes two `//` comment lines above its JSON, which jq does not
# read; whole-line comments are dropped before the merge, and Copilot restores its own on its next
# write. Any failure — a directory that cannot be written, a file that cannot be read or is not
# JSON — costs the entry, never the session: each step stands alone, since jq answers an empty
# input with no output and no error, which a pipeline would take for a merge.
merge_json() {
    file=$1
    filter=$2
    agent=$3
    stripped=
    staging=
    {
        mkdir -p "${file%/*}" \
            && { [ -s "$file" ] || printf '{}\n' > "$file"; } \
            && stripped=$(mktemp "$file.XXXXXX") \
            && staging=$(mktemp "$file.XXXXXX") \
            && sed '/^[[:space:]]*\/\//d' "$file" > "$stripped" \
            && jq --arg project "$project" "$filter" "$stripped" > "$staging" \
            && [ -s "$staging" ] \
            && mv -f "$staging" "$file"
    } 2>/dev/null || trust_warning "$file" "$agent"
    [ -n "$stripped" ] && rm -f "$stripped"
    [ -n "$staging" ] && rm -f "$staging"
    return 0
}
# Codex's user layer over the image's /etc/codex/config.toml. The file is read, judged and
# extended by a TOML parser, since the project's key has several spellings ([projects."/p"],
# [projects.'/p'], an inline table under [projects]) and a second definition makes the file
# invalid; a table Codex or the user wrote with another trust level is left as it is. The table
# is appended only after the document it would make has parsed: an inline `projects = {…}` cannot
# take a table outside its braces, and is left as written.
record_codex() {
    config=$volume/codex/config.toml
    state=$(mkdir -p "$volume/codex" && python3 - "$config" "$project" 2>/dev/null <<'PY'
import sys, tomllib
path, project = sys.argv[1], sys.argv[2]
try:
    with open(path, "rb") as file:
        text = file.read().decode()
except FileNotFoundError:
    text = ""
entry = tomllib.loads(text).get("projects", {}).get(project)
if entry is not None:
    print(entry.get("trust_level", "unset"))
    sys.exit()
key = project.replace("\\", "\\\\").replace('"', '\\"')
table = f'\n[projects."{key}"]\ntrust_level = "trusted"\n'
try:
    tomllib.loads(text + table)
except tomllib.TOMLDecodeError:
    print("unextendable")
    sys.exit()
with open(path, "a") as file:
    file.write(table)
print("recorded")
PY
    ) || state=unreadable
    case "$state" in
        trusted | recorded) ;;
        unreadable) trust_warning "$config" codex ;;
        unextendable)
            echo "warning: $config defines projects as an inline table, which cannot take" \
                "$project; codex may ask" >&2 ;;
        *) echo "warning: $config marks $project $state; codex may ask" >&2 ;;
    esac
}
# Under a lock on the volume, since launches of one project, and of several projects sharing a
# volume, record entries into the same files at once: unserialized, a read-modify-rename loses
# the other's entry and two appends leave Codex two tables.
if [ -d "$volume" ] && [ "$project" != / ]; then
    if exec 9<"$volume" && flock 9; then
        merge_json "$volume/claude/.claude.json" \
            '.projects[$project] |= ((. // {}) + {hasTrustDialogAccepted: true, hasCompletedProjectOnboarding: true})' \
            claude
        merge_json "$volume/antigravity/antigravity-cli/settings.json" \
            '.trustedWorkspaces |= ((. // []) | if index($project) then . else . + [$project] end)' \
            agy
        merge_json "$volume/copilot/config.json" \
            '.trustedFolders |= ((. // []) | if index($project) then . else . + [$project] end)' \
            copilot
        record_codex
        exec 9<&-
    else
        echo "warning: could not lock $volume to record $project as trusted; the agents may ask" >&2
    fi
fi

# kB, as /proc/meminfo counts; empty when the field is absent.
meminfo() { awk -v key="$1:" '$1 == key { print $2 }' "$proc/meminfo" 2>/dev/null; }
# A size in bytes as `df -h`, `du -h` and `ls -lh` print it, humanBytes in SandboxStats.scala
# spelled in awk: the largest unit reached, one decimal below 10 of it and none from 10 up, rounded
# up, 1023.6M carrying to 1.0G. Given a second size, the first in the second's unit, no suffix.
# awk counts in doubles, and the remainder's fivefold keeps every step exact to 2^53 bytes, 8 PiB:
# past every figure a machine reports here, short of what the Scala renderer takes.
human() {
    awk -v bytes="$1" -v whole="${2:-}" '
        function ceil(x) { return int(x) + (x > int(x)) }
        function figure(bytes, unit,   tenths) {
            if (unit == 1) return bytes
            tenths = int(bytes / unit) * 10 + ceil((bytes % unit) * 5 / (unit / 2))
            return tenths < 100 ? sprintf("%d.%d", tenths / 10, tenths % 10) : ceil(bytes / unit)
        }
        BEGIN {
            reference = whole == "" ? bytes : whole
            unit = 1; power = 0
            while (reference >= unit * 1024 && power < 6) { unit *= 1024; power++ }
            if (ceil(reference / unit) >= 1024 && power < 6) { unit *= 1024; power++ }
            printf "%s%s\n", figure(bytes, unit), (whole == "" && power > 0 ? substr("KMGTPE", power, 1) : "")
        }'
}

warnings=
warn() { warnings="$warnings  $1
"; }

available=$(meminfo MemAvailable)
total=$(meminfo MemTotal)
if [ -n "$available" ] && [ "$available" -lt 1048576 ]; then
    warn "$(human $((available * 1024)) $((total * 1024))) of $(human $((total * 1024))) memory available"
fi

# Pages left in swap after pressure has passed stay there until touched, so occupied swap alone
# says nothing; it is pressure when memory is tight now as well: under a quarter available.
swap_total=$(meminfo SwapTotal)
swap_free=$(meminfo SwapFree)
if [ -n "$swap_total" ] && [ -n "$swap_free" ] && [ "$swap_total" -gt "$swap_free" ] \
    && [ -n "$available" ] && [ "$available" -lt $((total / 4)) ]; then
    warn "$(human $(((swap_total - swap_free) * 1024))) of swap in use"
fi

# A kernel built with PSI disabled has the file and refuses the read (RHEL); then no line.
pressure=$(cat "$proc/pressure/memory" 2>/dev/null \
    | awk '$1 == "some" { split($3, avg, "="); print avg[2] }')
if [ -n "$pressure" ] && awk -v p="$pressure" 'BEGIN { exit !(p > 10) }'; then
    warn "memory pressure: tasks stalled on memory $pressure% of the last minute"
fi

# The persistent volume uses the machine's own filesystem, which is what image layers
# and containers fill; the root here is an overlay whose free space is one step removed.
disk=$(df -Pk "$volume" 2>/dev/null | awk 'NR == 2 { print $4 }')
if [ -n "$disk" ] && [ "$disk" -lt 2097152 ]; then
    warn "$(human $((disk * 1024))) of disk left on the machine"
fi

if [ -n "$warnings" ]; then
    memory_limit=$(cat /sys/fs/cgroup/memory.max 2>/dev/null || true)
    case "$memory_limit" in
        ''|max) memory_limit= ;;
        *) memory_limit=" This session may use up to $(human "$memory_limit") of it"
           memory_limit="$memory_limit (KO_AGENT_SANDBOX_MEMORY)." ;;
    esac
    {
        printf 'warning: the machine podman runs on is under pressure; '
        printf 'every session on it slows down or fails together\n%s' "$warnings"
        printf '  Stop other sessions and containers, or give the machine more (on a podman machine,\n'
        printf '  podman machine set --memory, machine stopped; podman system prune for disk).%s\n' "$memory_limit"
    } >&2
    if [ -t 0 ] && [ "${KO_AGENT_SANDBOX_SESSION_START:-pause}" != immediate ]; then
        printf '\nPress Enter to start anyway ' >&2
        read -r _ || :
    fi
fi

exec "$@"
