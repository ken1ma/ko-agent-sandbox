#!/bin/sh
#
# Gives one JVM what this session's network needs: the egress proxy's inspection CA, and the proxy itself.
#
# The image's own JDK has both already. At launch, the launcher runs this same script on that JDK in a throwaway
# container and mounts the two files the script wrote, read-only (JdkTrust.scala).
# In a session, the script serves the JVMs that the launcher cannot reach: a JDK the agent installed with
# `cs java --jvm temurin:25`, or any JDK unpacked by hand. Left untouched, such a JDK fails a dependency resolve for
# two reasons and says nothing about either: it has no route to the proxy, and it does not trust the certificate
# that an inspected host presents.
#
#   ko-sandbox-jdk-use-proxy                  # $JAVA_HOME
#   ko-sandbox-jdk-use-proxy /path/to/jdk     # some other JDK
#
# The script does not serve a GraalVM native image (cs, scala). A native image has no conf/ to edit, and it takes
# the same facts as -D options, through KO_AGENT_SANDBOX_JAVA_OPTS in the agent instructions.
#
# The script is idempotent and safe to point at the image's JDK: it reports what is already true rather than fail
# on the read-only files. The certificate is public, and the private key that signs with it never enters this
# container (SECURITY.md, "Who holds the CA key").
set -eu

# The launcher sets HTTPS_PROXY for every session and for its own run of this script. The script reads the proxy's
# address from that variable rather than spelling it here, so the launcher stays the address's only home.
case "${HTTPS_PROXY:-}" in
    http://*) ;;
    *)
        echo "${0##*/}: HTTPS_PROXY is not an http:// URL, so there is no proxy to point the JDK at" >&2
        exit 2
        ;;
esac
proxy_address=${HTTPS_PROXY#http://}
proxy_address=${proxy_address%/}
PROXY_HOST=${proxy_address%:*}
PROXY_PORT=${proxy_address##*:}
if [ -z "$PROXY_HOST" ] || [ "$PROXY_HOST" = "$PROXY_PORT" ]; then
    echo "${0##*/}: HTTPS_PROXY=$HTTPS_PROXY names no host:port" >&2
    exit 2
fi

CA=/etc/ko-agent-sandbox/egress-proxy-ca.crt
ALIAS=ko-agent-sandbox-egress
# Every JDK ships cacerts under this password. The password is not a secret, and the store holds only certificates.
STOREPASS=changeit

# The variable is named JAVA_HOME because it holds the home of the JDK being prepared.
JAVA_HOME="${1:-${JAVA_HOME:-}}"

if [ $# -gt 1 ] || [ -z "$JAVA_HOME" ]; then
    echo "usage: ${0##*/} [JAVA_HOME]" >&2
    [ $# -gt 1 ] || echo "  no argument and JAVA_HOME is unset, so there is no JDK to prepare" >&2
    exit 2
fi

if [ ! -x "$JAVA_HOME/bin/keytool" ]; then
    echo "${0##*/}: no keytool at $JAVA_HOME/bin/keytool" >&2
    exit 1
fi

# Writes the proxy where the JDK's own ProxySelector reads it.
# - JAVA_TOOL_OPTIONS would also work, but it adds a banner to every JVM start, which corrupts output that other
#   programs parse. This function sets no system property at all.
# - The function appends its block, because a properties file takes the last assignment of a key.
# - http.nonProxyHosts stays as shipped, since it already spells the loopback exemptions that NO_PROXY lists.
set_proxy() {
    net=$JAVA_HOME/conf/net.properties
    # A missing file is a failure, not a report: every Java 9+ runtime ships this file, and without the proxy the
    # JDK reaches no host at all. A success here would certify a half-prepared JDK.
    if [ ! -f "$net" ]; then
        echo "${0##*/}: no $net, so this JDK cannot be pointed at the proxy; it is not a runtime" >&2
        echo "  layout this program can prepare. Install a full JDK (cs java --jvm temurin:25)." >&2
        exit 1
    fi
    # "Already set" means that the file's *effective* values are this proxy's, as judged by the parser that will
    # consume the file: the target JDK's own Properties.load.
    # - A reading in the shell only approximates that format, and an approximation errs in both directions.
    #   `key : value` and `key value` are legal spellings that a grep for `key=` misses. A regex dot in the key
    #   matches characters it should not. The last assignment is the one that counts.
    # - A JDK whose java cannot run the probe answers nothing, which reads as unprepared. The function then appends
    #   the block again, and the appended block is the last word either way.
    probe_dir=$(mktemp -d)
    cat > "$probe_dir/EffectiveProperties.java" <<'EOF'
import java.io.FileInputStream;
import java.util.Properties;

public class EffectiveProperties {
    public static void main(String[] args) throws Exception {
        Properties loaded = new Properties();
        try (FileInputStream in = new FileInputStream(args[0])) {
            loaded.load(in);
        }
        for (int i = 1; i < args.length; i++) {
            System.out.println(loaded.getProperty(args[i], ""));
        }
    }
}
EOF
    effective=$("$JAVA_HOME/bin/java" "$probe_dir/EffectiveProperties.java" "$net" \
        http.proxyHost http.proxyPort https.proxyHost https.proxyPort 2>/dev/null || true)
    rm -rf "$probe_dir"
    wanted=$(printf '%s\n%s\n%s\n%s' "$PROXY_HOST" "$PROXY_PORT" "$PROXY_HOST" "$PROXY_PORT")
    if [ "$effective" = "$wanted" ]; then
        echo "egress proxy already set: $net"
        return
    fi
    # The function copies the original beside the file before the first append, and only if no copy is there yet,
    # so a rerun cannot overwrite the true original with an already-appended one. The copy is named for this program
    # rather than `.dist`, which would claim that nobody changed the file since distribution, and nobody verified
    # that. /etc/fuse.conf gets the same convention (KoAgentFs.KoAgentFsFuseConfBackup).
    [ -e "$net.ko-agent-sandbox.orig" ] || cp "$net" "$net.ko-agent-sandbox.orig"
    cat >> "$net" <<EOF

# ko-agent-sandbox: the proxy is the only route out, and a JVM reads none of the
# HTTPS_PROXY family.
http.proxyHost=$PROXY_HOST
http.proxyPort=$PROXY_PORT
https.proxyHost=$PROXY_HOST
https.proxyPort=$PROXY_PORT
EOF
    echo "egress proxy added to $net (original: $net.ko-agent-sandbox.orig)"
}

set_proxy

# The CA exists only where the session inspects a host. Without inspection, the proxy settings
# above suffice and there is no extra certificate to trust.
if [ ! -r "$CA" ]; then
    echo "${0##*/}: $CA is absent, so this session inspects no host; nothing to trust"
    exit 0
fi

# Extracts the colon-hex SHA-256 that both keytool outputs below print, whatever label they print it under.
fingerprint_of() {
    grep -Eo '([0-9A-F]{2}:){31}[0-9A-F]{2}' | head -1
}

# -cacerts targets the store of the keytool being run, which is why the script invokes the target JDK's own keytool
# rather than whichever keytool is on PATH.
#
# Idempotence must compare the certificate, not just find the alias. A JDK kept on a volume shared across
# workspaces can hold this alias for another workspace's CA. "Already trusted" over the wrong certificate would be
# exactly the unexplained TLS failure this program exists to end.
want=$("$JAVA_HOME/bin/keytool" -printcert -file "$CA" | fingerprint_of)
have=$("$JAVA_HOME/bin/keytool" -list -cacerts -storepass "$STOREPASS" -alias "$ALIAS" 2>/dev/null \
    | fingerprint_of)

# An empty want must fail here, never compare: two empty fingerprints are equal. Otherwise a keytool that cannot
# fingerprint the CA would report "already trusted" against a broken store.
if [ -z "$want" ]; then
    echo "${0##*/}: $JAVA_HOME/bin/keytool could not fingerprint $CA" >&2
    exit 1
fi

if [ "$have" = "$want" ]; then
    echo "egress CA already trusted: $JAVA_HOME"
    exit 0
fi

if [ -n "$have" ]; then
    echo "alias $ALIAS holds a different certificate (another workspace's CA?); replacing it"
    "$JAVA_HOME/bin/keytool" -delete -cacerts -storepass "$STOREPASS" -alias "$ALIAS" >/dev/null
fi

"$JAVA_HOME/bin/keytool" -importcert -noprompt -cacerts -storepass "$STOREPASS" \
    -alias "$ALIAS" -file "$CA"
echo "egress CA added to $JAVA_HOME"
