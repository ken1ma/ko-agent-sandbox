# The PulseAudio daemon's script under --audio=mic. ko-sandbox-entrypoint loads it with `pulseaudio -n --file=`
# and nothing else (doc/microphone.md, "The daemon"). The FIFO's path is under MicrophoneRelay.SandboxDir.
.fail

# The microphone is a FIFO that the host relay's writer fills.
# - The module makes the FIFO and holds it open read-write. The writer therefore opens the FIFO without waiting,
#   and the writer's close is not an EOF.
# - The module's source keeps the default name, fifo_input, which ko-sandbox-mic looks for.
load-module module-pipe-source file=/tmp/ko-agent-sandbox/microphone/mic format=s16le rate=16000 channels=1

# Codex's speaker uses the source's sample spec, so the loopback converts nothing.
load-module module-null-sink sink_name=speaker format=s16le rate=16000 channels=1

# A permanent output on the microphone keeps the pipe source running and reading its FIFO. Audio written while no
# agent records is dropped here instead of reaching the next recording.
# adjust_time=0 stops the rate readjustment toward a latency target, which this drop path has no use for.
load-module module-loopback source=fifo_input sink=speaker adjust_time=0 source_dont_move=true

# The socket that PULSE_SERVER names is the module's default, `native` under PULSE_RUNTIME_PATH.
# The socket needs no cookie: every process in the container runs as one uid, and the socket reaches nothing outside
# the container.
# auth-cookie-enabled=0 stops the module from making a cookie; anonymous access alone leaves cookie handling on.
load-module module-native-protocol-unix auth-anonymous=1 auth-cookie-enabled=0

set-default-source fifo_input
set-default-sink speaker
