ARG IMG_TAG_VER
FROM debian-coursier:${IMG_TAG_VER}

# This image stays on `latest`: rebuilds pick up agent releases, which
# IMG_TAG_VER says nothing about; the label records the base instead.
ARG IMG_TAG_VER
LABEL org.opencontainers.image.base.name="debian-coursier:${IMG_TAG_VER}"

# The digest of this directory as the launcher bundled it (KoAgentFs.contextSourceId). A launch
# recomputes it from its own jar and refuses a default-named image another jar built — the
# version lock between launcher and image (AgentSandboxLauncher.bundleMismatch).
ARG BUNDLE_ID
LABEL ko-agent-sandbox.bundle=${BUNDLE_ID}

ARG UV_VERSION=0.12.13
ARG PYTHON_VERSION=3.14
ARG WCWIDTH_VERSION=0.8.4
ARG LYCHEE_VERSION=0.24.2
ARG NODE_VERSION=24.21.0

# ---------------------------------------------------------------------------
# Development utilities
# ---------------------------------------------------------------------------
#
# ripgrep: Claude Code bundles `rg`, but generated scripts use it.
# openssl: present anyway — ca-certificates depends on it.
# Excluded: git-lfs; sqlite3 (python3 covers it); shellcheck (40 MB).

RUN set -euxo pipefail; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        # curl and ca-certificates are installed in the parent image
        git \
        ripgrep \
        patch \
        unzip \
        xz-utils \
        zstd \
        # ps, pgrep, top, free, uptime
        procps \
        # pstree, fuser, killall
        psmisc \
        file \
        jq; \
    rm -rf /var/lib/apt/lists/*

# Avoid interactive pagers when Claude executes commands and needs their complete output.
ENV GIT_PAGER=cat
ENV PAGER=cat


# ---------------------------------------------------------------------------
# uv + Python
# ---------------------------------------------------------------------------
#
# 2026 models like to use python.
#
COPY --from=ghcr.io/astral-sh/uv:${UV_VERSION} /uv /uvx /bin/

# /opt/uv/python and /usr/local/bin are image-managed; runtime uv keeps
# using ~/.local.
RUN set -euxo pipefail; \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_PYTHON_BIN_DIR=/usr/local/bin \
    uv python install "${PYTHON_VERSION}" --default

# ko-sandbox-text-width's import comment explains why this is outside site-packages.
RUN set -euxo pipefail; \
    uv pip install --no-cache --target /opt/ko-sandbox/python "wcwidth==${WCWIDTH_VERSION}"

# ko-sandbox-link-check runs lychee. The musl asset is static, so it needs nothing from the base image.
RUN set -euxo pipefail; \
    LYCHEE_ASSET="lychee-$(uname -m)-unknown-linux-musl.tar.gz"; \
    LYCHEE_RELEASE="https://github.com/lycheeverse/lychee/releases/download/lychee-v${LYCHEE_VERSION}"; \
    cd /tmp; \
    curl -fsSL -O "${LYCHEE_RELEASE}/${LYCHEE_ASSET}"; \
    curl -fsSL "${LYCHEE_RELEASE}/${LYCHEE_ASSET}.sha256" | sha256sum -c -; \
    tar -xzf "$LYCHEE_ASSET" --strip-components=1 -C /usr/local/bin "${LYCHEE_ASSET%.tar.gz}/lychee"; \
    rm "$LYCHEE_ASSET"; \
    lychee --version

ENV PATH="/home/nonroot/.local/bin:$PATH"


# ---------------------------------------------------------------------------
# Node.js
# ---------------------------------------------------------------------------
#
# Not for Node development — `npx` is the de-facto MCP launcher, and agents
# reach for one-off JS tooling. Debian's nodejs+npm resolve to 374 packages
# and lag LTS; the official tarball is one artifact.
#
# SHASUMS256.txt over TLS from the same host is an integrity check, not a
# signature (the .sig would need gnupg plus the release keyring).
#
# Dropped: include/ (63 MB, only for native addons — node-gyp fetches its
# own headers, and the image has no make or g++ to build one anyway) and
# share/ + docs (no man reader). Bump NODE_VERSION and rebuild to move LTS.
RUN set -euxo pipefail; \
    case "$(uname -m)" in \
        aarch64) NODE_ARCH=arm64 ;; \
        x86_64)  NODE_ARCH=x64 ;; \
        *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    NODE_TARBALL="node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz"; \
    # `sha256sum -c` resolves the filename relative to the current directory.
    cd /tmp; \
    curl -fsSL -O "https://nodejs.org/dist/v${NODE_VERSION}/${NODE_TARBALL}"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" \
        | grep -F "  ${NODE_TARBALL}" \
        | sha256sum -c -; \
    install -d -m 0755 /opt/node; \
    tar -xJf "${NODE_TARBALL}" -C /opt/node --strip-components=1; \
    rm "${NODE_TARBALL}"; \
    rm -rf \
        /opt/node/include \
        /opt/node/share \
        /opt/node/CHANGELOG.md \
        /opt/node/README.md; \
    /opt/node/bin/node --version

# `npm` and `npx` are `#!/usr/bin/env node` scripts, so this is what makes them work at all, not merely a convenience.
ENV PATH="/opt/node/bin:$PATH"

# npm's default global prefix is the read-only Node installation; without
# this, `npm install -g` and `npx` both fail. ~/.local is per-session by
# intent: an npx run in one repository must not leave code behind for the
# next.
ENV npm_config_prefix=/home/nonroot/.local


# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
#
# Tracks stable and moves on rebuild, like the agents.
#
# gcc + libc6-dev are here as Rust's linker driver, not as a C toolchain:
# rustc's own LLVM emits the objects and only shells out to cc to drive ld
# against glibc's crt*.o. Kept out of AGENTS-SANDBOX.md's program table for that
# reason — nothing here invites C development, though gcc compiles C if asked.
#
# Needed even though ko-agent-fs both ships and tests as static musl: proc-macro
# dylibs always build for the host whatever the final target, so a working host
# linker is unavoidable, and the musl target added below does not displace it.
# musl-tools is the other half — musl-gcc, which linking that target wants, the
# same package ko-agent-fs's own build container installs.
#
# RUSTUP_HOME holds the toolchain in the image; CARGO_HOME is deliberately
# left unset, so registry caches are written to ~/.cargo and die with the session
# like every other cache.

ENV RUSTUP_HOME=/opt/rust/rustup

RUN set -euxo pipefail; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        gcc \
        libc6-dev \
        musl-tools; \
    rm -rf /var/lib/apt/lists/*; \
    cd /tmp; \
    # uname -m (aarch64, x86_64) is the exact first component of Rust's target triple, so no arch mapping.
    RUSTUP_URL="https://static.rust-lang.org/rustup/dist/$(uname -m)-unknown-linux-gnu/rustup-init"; \
    curl -fsSL -O "$RUSTUP_URL"; \
    # The .sha256 file's name field carries a dist path, so compare the digest alone.
    expected="$(curl -fsSL "$RUSTUP_URL.sha256" | awk '{print $1}')"; \
    echo "$expected  rustup-init" | sha256sum -c -; \
    chmod 0755 rustup-init; \
    CARGO_HOME=/opt/rust/cargo ./rustup-init -y --no-modify-path \
        --profile minimal --default-toolchain stable \
        --component rustfmt --component clippy; \
    # The triple ko-agent-fs ships as, so a session can run its tests against the
    # libc that ships (fuse/ko-agent-fs/doc/testing.md). It has to be added here:
    # RUSTUP_HOME is read-only at runtime, so a session cannot add it later.
    CARGO_HOME=/opt/rust/cargo /opt/rust/cargo/bin/rustup target add \
        "$(uname -m)-unknown-linux-musl"; \
    rm rustup-init

ENV PATH="/opt/rust/cargo/bin:$PATH"


# ---------------------------------------------------------------------------
# Persisted agent state
# ---------------------------------------------------------------------------
#
# The launcher mounts a per-project named volume at ~/persistent-volume;
# each agent's dot-directory is a relative symlink into it, so no relocation
# variables are needed. opencode's three XDG directories are linked one by
# one for the same reason: XDG_*_HOME variables would move every other
# program's directories too. Its data directory holds the logins (auth.json)
# and the sessions, so its config directory alone would lose them; its
# cache, ~/.cache/opencode, dies with the session like every cache.
# kiro-cli is split the same way — settings, agents and steering under
# ~/.kiro, the logins and the rest of its data under
# ~/.local/share/kiro-cli — so both of its directories are linked.
# The volume's content starts as the seed below, which
# ko-sandbox-entrypoint copies in per agent directory wherever the volume lacks one:
# not only into a fresh volume, as Podman's copy-up would, but into one an
# older image created before an agent was added. A directory the volume has
# is agent state and is never touched, so a seed change reaches existing
# volumes only through --reset, which also discards their logins.

ENV KO_SANDBOX_VOLUME_SEED=/etc/ko-agent-sandbox/persistent-volume-seed
RUN set -euxo pipefail; \
    install -d -o nonroot -g nonroot -m 0700 /home/nonroot/persistent-volume; \
    # nonroot-owned: ko-sandbox-entrypoint reads the seed as nonroot, and the copies keep the mode
    install -d -o nonroot -g nonroot -m 0700 \
        $KO_SANDBOX_VOLUME_SEED/claude \
        $KO_SANDBOX_VOLUME_SEED/codex \
        $KO_SANDBOX_VOLUME_SEED/antigravity \
        $KO_SANDBOX_VOLUME_SEED/kiro \
        $KO_SANDBOX_VOLUME_SEED/kiro/config \
        $KO_SANDBOX_VOLUME_SEED/kiro/data \
        $KO_SANDBOX_VOLUME_SEED/copilot \
        $KO_SANDBOX_VOLUME_SEED/opencode \
        $KO_SANDBOX_VOLUME_SEED/opencode/config \
        $KO_SANDBOX_VOLUME_SEED/opencode/data \
        $KO_SANDBOX_VOLUME_SEED/opencode/state; \
    # the parents of the links below
    install -d -o nonroot -g nonroot \
        /home/nonroot/.config \
        /home/nonroot/.local \
        /home/nonroot/.local/share \
        /home/nonroot/.local/state; \
    ln -s persistent-volume/claude /home/nonroot/.claude; \
    ln -s persistent-volume/codex /home/nonroot/.codex; \
    # agy reads its state from ~/.gemini, not a name of its own
    ln -s persistent-volume/antigravity /home/nonroot/.gemini; \
    ln -s persistent-volume/kiro/config /home/nonroot/.kiro; \
    ln -s ../../persistent-volume/kiro/data /home/nonroot/.local/share/kiro-cli; \
    ln -s persistent-volume/copilot /home/nonroot/.copilot; \
    ln -s ../persistent-volume/opencode/config /home/nonroot/.config/opencode; \
    ln -s ../../persistent-volume/opencode/data /home/nonroot/.local/share/opencode; \
    ln -s ../../persistent-volume/opencode/state /home/nonroot/.local/state/opencode; \
    chown -h nonroot:nonroot \
        /home/nonroot/.claude \
        /home/nonroot/.codex \
        /home/nonroot/.gemini \
        /home/nonroot/.kiro \
        /home/nonroot/.local/share/kiro-cli \
        /home/nonroot/.copilot \
        /home/nonroot/.config/opencode \
        /home/nonroot/.local/share/opencode \
        /home/nonroot/.local/state/opencode


# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
#
# `latest` rather than `stable`: the update check compares against `latest`,
# and `stable` lags it into a permanent "Update available!" banner. Updates
# arrive by rebuilding.

RUN set -euxo pipefail; \
    install -d -m 0755 /etc/apt/keyrings; \
    curl -fsSL \
        https://downloads.claude.ai/keys/claude-code.asc \
        -o /etc/apt/keyrings/claude-code.asc; \
    printf '%s\n' \
        'Types: deb' \
        'URIs: https://downloads.claude.ai/claude-code/apt/latest' \
        'Suites: latest' \
        'Components: main' \
        'Signed-By: /etc/apt/keyrings/claude-code.asc 31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE' \
        > /etc/apt/sources.list.d/claude-code.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        claude-code \
        # Claude Code's own sandbox for Bash commands, off in the managed settings below.
        # Carried because an organization's server-managed settings, which outrank that
        # file, can enforce sandbox.failIfUnavailable: without these the session exits,
        # with the reason on stderr, which the TUI discards. Enabled in here it would
        # also need enableWeakerNestedSandbox: bwrap cannot mount a fresh /proc under
        # podman's masked /proc entries (measured, as for Codex below).
        bubblewrap \
        socat; \
    rm -rf /var/lib/apt/lists/*

# .claude.json defaults to $HOME; move it under ~/.claude so it persists through the symlink.
ENV CLAUDE_CONFIG_DIR=/home/nonroot/.claude

# Skip permission prompts (README.md explains why).
#
# Managed settings in the read-only image take precedence over user and
# project settings, survive removal of the persistent volume, and apply
# without launcher flags. An organization's remote managed settings can
# supersede the image's permission, hook and sandbox settings, including
# requiring the sandbox installed in the apt step above. By default Claude
# Code selects one managed source for most keys; administrators can enable
# merging across sources.
# `/status` identifies the active sources. Precedence and exceptions:
# https://code.claude.com/docs/en/managed-settings#how-claude-code-combines-managed-sources
#
# `bypassPermissions` refuses to start as root; USER below is nonroot.
# `skipDangerousModePermissionPrompt` pre-accepts bypass mode's one-time
# dialog. These settings do not prevent prompt injection (SECURITY.md).
# Consider `"defaultMode": "auto"` to screen tool calls induced by prompt
# injection.
#
# Hook commands run without the model choosing them as tool calls, so
# restoring permission prompts or enabling auto mode does not review those
# commands. `allowManagedHooksOnly` blocks this automatic execution path
# from project settings and writable user settings in the persistent volume.
# ko-sandbox-entrypoint pre-accepts workspace trust, so the trust dialog
# reviews neither source. Sandbox commands can still modify persistent
# state (SECURITY.md, "What the persistent volume holds").
# Managed hooks, SDK hooks and hooks from plugins force-enabled by managed
# settings remain allowed:
# https://code.claude.com/docs/en/settings-reference#allowmanagedhooksonly
#
# Host verification with Claude Code 2.1.274 shows that a project's
# SessionStart hook is blocked under this image and runs under a variant
# image without the key. The comparison uses a variant image because /etc
# is read-only in a session. A project cannot instead redirect the managed
# settings through its settings env: that version's
# CLAUDE_CODE_MANAGED_SETTINGS_PATH is a stub that returns nothing.
#
# `sandbox` off: this container is the boundary, and Claude Code's own
# bubblewrap sandbox would be a second one inside it, which a project's
# `sandbox.failIfUnavailable` could otherwise demand. Off also keeps
# anthropics/claude-code#88059 out: with that sandbox active on a merged-usr
# distro, 2.1.232 and later lose every Bash call. Debian is merged-usr.
RUN set -euxo pipefail; \
    install -d -m 0755 /etc/claude-code; \
    printf '%s\n' \
        '{' \
        '  "permissions": {' \
        '    "defaultMode": "bypassPermissions"' \
        '  },' \
        '  "skipDangerousModePermissionPrompt": true,' \
        '  "allowManagedHooksOnly": true,' \
        '  "sandbox": {' \
        '    "enabled": false,' \
        '    "failIfUnavailable": false,' \
        '    "allowUnsandboxedCommands": true' \
        '  }' \
        '}' \
        > /etc/claude-code/managed-settings.json

# allowManagedHooksOnly also blocks user and project status-line commands.
# The managed command accepts a data-only project template so display
# customization does not require a project-supplied command.
# Usage: doc/agent-settings.md, "Claude Code status line".
COPY --chmod=0644 claude-code/command/ /etc/claude-code/command/
COPY --chmod=0644 claude-code/managed-settings.d/ /etc/claude-code/managed-settings.d/


# ---------------------------------------------------------------------------
# Codex CLI
# ---------------------------------------------------------------------------
#
# OpenAI publishes no APT repository, and the npm package wraps the same
# native build. The musl build is static. `releases/latest` mirrors the
# Claude `latest` suite; verifying the *.sigstore bundles would need cosign,
# so TLS to github.com is the integrity boundary.
RUN set -euxo pipefail; \
    CODEX_ARTIFACT="codex-package-$(uname -m)-unknown-linux-musl"; \
    install -d -m 0755 /opt/codex; \
    curl -fsSL \
        "https://github.com/openai/codex/releases/latest/download/${CODEX_ARTIFACT}.tar.gz" \
        | tar -xzf - -C /opt/codex

# Codex is run from the package directory rather than symlinked into
# /usr/local/bin, so that nothing depends on how the helper lookup resolves a
# symlinked argv[0].
ENV PATH="/opt/codex/bin:$PATH"

# What codex/bash-env restores (codex/config.toml has why).
ENV KO_SANDBOX_TOOLCHAIN_PATH="$PATH"

# /etc/codex/config.toml is the documented system layer, lowest precedence:
# in the read-only image like managed settings, but supplying *defaults* the
# user config can override — opting back into approval prompts for a scary
# repository should not need an image rebuild (enforcement would be
# managed_config.toml).
#
# danger-full-access: the container is the boundary, and Codex's own Linux
# sandbox cannot finish setting up here. Measured, not assumed: unshare -Ur
# works under --cap-drop=ALL, but mounting a fresh /proc fails while
# podman's masked /proc entries are in place, and the bubblewrap-style
# sandbox needs one for its pid namespace.
#
# The project's trust_level is ko-sandbox-entrypoint's, in the user layer
# ~/.codex/config.toml: it is per project, and this layer is the image's.
COPY --chmod=0644 codex/config.toml /etc/codex/config.toml
COPY --chmod=0644 codex/bash-env /etc/codex/bash-env


# ---------------------------------------------------------------------------
# Antigravity CLI
# ---------------------------------------------------------------------------
#
# Google distributes agy through an install script that resolves a
# per-platform manifest {version, url, sha512}; the manifest is used
# directly so the binary is stored in the read-only image, keeping the sha512
# check and skipping the shell-profile editing. agy self-updates only where
# its binary is writable; /usr/local/bin is not, so it updates on rebuild
# like the others. The smoke test gets a throwaway HOME because agy writes
# state on every invocation and this RUN is root.

RUN set -euxo pipefail; \
    AGY_MANIFEST="$(curl -fsSL \
        "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_$(dpkg \
        --print-architecture).json")"; \
    curl -fsSL "$(printf '%s' "$AGY_MANIFEST" | jq -re .url)" -o /tmp/agy.tar.gz; \
    printf '%s  /tmp/agy.tar.gz\n' "$(printf '%s' "$AGY_MANIFEST" | jq -re .sha512)" \
        | sha512sum -c -; \
    tar -xzf /tmp/agy.tar.gz -C /tmp antigravity; \
    install -m 0755 /tmp/antigravity /usr/local/bin/agy; \
    rm /tmp/agy.tar.gz /tmp/antigravity; \
    HOME=/tmp/agy-smoke agy --version >/dev/null; \
    rm -rf /tmp/agy-smoke

# All agy state is under ~/.gemini, a symlink into the persistent volume.
# toolPermission=always-proceed auto-approves tool execution (the counterpart of
# Claude's bypassPermissions and Codex's approval_policy="never"); the project's
# trust entry is ko-sandbox-entrypoint's, per launch.
RUN set -euxo pipefail; \
    install -d -o nonroot -g nonroot -m 0700 \
        $KO_SANDBOX_VOLUME_SEED/antigravity/antigravity-cli; \
    printf '%s\n' \
        '{' \
        '  "toolPermission": "always-proceed"' \
        '}' \
        > $KO_SANDBOX_VOLUME_SEED/antigravity/antigravity-cli/settings.json


# ---------------------------------------------------------------------------
# Kiro CLI
# ---------------------------------------------------------------------------
#
# AWS distributes kiro-cli as a zip whose install script copies the binaries
# to ~/.local/bin and edits the shell profile; the binaries go into the
# read-only image straight from the zip, checked against the .sha256
# published beside it. All of bin/: kiro-cli execs kiro-cli-chat for the
# chat and agent commands. `latest`, as for the others; the glibc build,
# not the musl one, as for OpenCode. The smoke test gets a throwaway HOME
# because kiro-cli writes state on every invocation and this RUN is root.
RUN set -euxo pipefail; \
    KIRO_ZIP="https://desktop-release.q.us-east-1.amazonaws.com/latest/kirocli-$(uname -m)-linux.zip"; \
    curl -fsSL "$KIRO_ZIP" -o /tmp/kirocli.zip; \
    printf '%s  /tmp/kirocli.zip\n' "$(curl -fsSL "$KIRO_ZIP.sha256" | awk '{ print $1 }')" \
        | sha256sum -c -; \
    unzip -q /tmp/kirocli.zip -d /tmp; \
    install -m 0755 /tmp/kirocli/bin/* /usr/local/bin/; \
    rm -r /tmp/kirocli.zip /tmp/kirocli; \
    HOME=/tmp/kiro-smoke kiro-cli --version >/dev/null; \
    rm -rf /tmp/kiro-smoke

# Tool prompts off, the Codex counterpart above. kiro-cli's own switch is
# the per-launch flag --trust-all-tools, so the default agent is instead a
# seeded custom agent whose allowedTools names every built-in tool and
# every tool of every MCP server (allowedTools takes no bare "*"). Like
# agy's settings.json it is user state in the persistent volume: opting
# back into prompts is an edit there. No resources entry: a custom agent
# inherits the global steering, where the instructions link below lands,
# unless chat.disableInheritingDefaultResources is set.
# app.disableAutoupdates: the startup update check would only be refused
# by the proxy, its host being absent from model-provider/aws, and updates
# arrive by rebuilding like the others.
RUN set -euxo pipefail; \
    install -d -o nonroot -g nonroot -m 0700 \
        $KO_SANDBOX_VOLUME_SEED/kiro/config/settings \
        $KO_SANDBOX_VOLUME_SEED/kiro/config/agents; \
    printf '%s\n' \
        '{' \
        '  "app.disableAutoupdates": true,' \
        '  "chat.defaultAgent": "ko-agent-sandbox"' \
        '}' \
        > $KO_SANDBOX_VOLUME_SEED/kiro/config/settings/cli.json; \
    printf '%s\n' \
        '{' \
        '  "description": "Every tool trusted: the container is the boundary",' \
        '  "tools": [' \
        '    "*"' \
        '  ],' \
        '  "allowedTools": [' \
        '    "@builtin",' \
        '    "@*/*"' \
        '  ]' \
        '}' \
        > $KO_SANDBOX_VOLUME_SEED/kiro/config/agents/ko-agent-sandbox.json


# ---------------------------------------------------------------------------
# Copilot CLI
# ---------------------------------------------------------------------------
#
# GitHub's install script (gh.io/copilot-install) fetches the release tarball
# and checks it against the release's SHA256SUMS; the same two fetches here,
# without the shell-profile editing. The npm package wraps the same binary.
# `releases/latest` as for Codex, so a release published between the two
# fetches fails the checksum and the build, never installs a mismatch. The
# smoke test gets a throwaway HOME because copilot writes a package cache on
# every invocation and this RUN is root.
RUN set -euxo pipefail; \
    COPILOT_ASSET="copilot-linux-$(dpkg --print-architecture | sed s/amd64/x64/).tar.gz"; \
    COPILOT_RELEASE=https://github.com/github/copilot-cli/releases/latest/download; \
    curl -fsSL "${COPILOT_RELEASE}/${COPILOT_ASSET}" -o /tmp/copilot.tar.gz; \
    printf '%s  /tmp/copilot.tar.gz\n' \
        "$(curl -fsSL "${COPILOT_RELEASE}/SHA256SUMS.txt" \
            | awk -v asset="$COPILOT_ASSET" '$2 == asset { print $1 }')" \
        | sha256sum -c -; \
    tar -xzf /tmp/copilot.tar.gz -C /tmp copilot; \
    install -m 0755 /tmp/copilot /usr/local/bin/copilot; \
    rm /tmp/copilot.tar.gz /tmp/copilot; \
    HOME=/tmp/copilot-smoke copilot --version >/dev/null; \
    rm -rf /tmp/copilot-smoke

# A read-only binary does not stop copilot's updater: it extracts new
# versions into a package cache under ~/.cache/copilot and runs those. Off,
# so it updates on rebuild like the others.
ENV COPILOT_AUTO_UPDATE=false

# Tool prompts off, the Codex counterpart above. Copilot has no system config
# layer, so the default is an environment variable a launch can override
# (COPILOT_ALLOW_ALL=false). It covers tools only; --yolo adds paths outside
# the project and URLs, whose prompts the user keeps otherwise. The project's
# trust entry in ~/.copilot/config.json is ko-sandbox-entrypoint's, per launch.
ENV COPILOT_ALLOW_ALL=true


# ---------------------------------------------------------------------------
# OpenCode
# ---------------------------------------------------------------------------
#
# The release ships no checksum file; the release API's asset `digest` is the
# one source. One read of `releases/latest` names the asset and its digest
# together, so a release published mid-build cannot mismatch them.
# The x64 build needs AVX2, and the CPU building the image is the CPU running
# it — the podman machine's, or the Linux host's — so its flag decides. The
# glibc build, not the musl one: Debian has glibc. The smoke test gets a
# throwaway HOME because OpenCode creates its XDG directories on every start,
# and this RUN is root.
RUN set -euxo pipefail; \
    case "$(uname -m)" in \
        aarch64) OPENCODE_ASSET=opencode-linux-arm64.tar.gz ;; \
        x86_64) \
            if grep -qw avx2 /proc/cpuinfo; then OPENCODE_ASSET=opencode-linux-x64.tar.gz; \
            else OPENCODE_ASSET=opencode-linux-x64-baseline.tar.gz; fi ;; \
        *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    OPENCODE_ASSET_JSON="$(curl -fsSL https://api.github.com/repos/anomalyco/opencode/releases/latest \
        | jq -ce --arg name "$OPENCODE_ASSET" '[.assets[] | select(.name == $name)] | select(length == 1) | .[0]')"; \
    curl -fsSL "$(printf '%s' "$OPENCODE_ASSET_JSON" | jq -re .browser_download_url)" -o /tmp/opencode.tar.gz; \
    printf '%s  /tmp/opencode.tar.gz\n' \
        "$(printf '%s' "$OPENCODE_ASSET_JSON" \
            | jq -re '.digest | select(startswith("sha256:")) | ltrimstr("sha256:")')" \
        | sha256sum -c -; \
    tar -xzf /tmp/opencode.tar.gz -C /tmp opencode; \
    install -m 0755 /tmp/opencode /usr/local/bin/opencode; \
    rm /tmp/opencode.tar.gz /tmp/opencode; \
    HOME=/tmp/opencode-smoke opencode --version >/dev/null; \
    rm -rf /tmp/opencode-smoke

# /etc/opencode/opencode.json is OpenCode's managed layer, merged after the
# user's and the project's files, so neither can turn these back.
# permission allow: the counterpart of Claude's bypassPermissions above.
# OPENCODE_PERMISSION is read after this file, so a launch that forwards it
# puts the prompts back (doc/agent-settings.md, "Restoring permission prompts").
# share disabled: /share would post the session to opncd.ai, or to an
# enterprise's own URL, either of which a project rule line could allow.
# autoupdate false: the binary is the image's, and the check alone reads the
# GitHub release API at every start.
RUN set -euxo pipefail; \
    install -d -m 0755 /etc/opencode; \
    printf '%s\n' \
        '{' \
        '  "autoupdate": false,' \
        '  "permission": "allow",' \
        '  "share": "disabled"' \
        '}' \
        > /etc/opencode/opencode.json


# ---------------------------------------------------------------------------
# Environment documentation for the agents
# ---------------------------------------------------------------------------
#
# AGENTS-SANDBOX.md tells the running agent what this container is. It ships
# as AGENTS.md, the target of every link below. The launcher mounts a copy over
# AGENTS.md with the session's permissions and ruleset lookup instructions
# appended.
# Without it an agent reads `Read-only file system` as breakage, or writes
# deliverables somewhere discarded on exit.
#
#   claude  /etc/claude-code/CLAUDE.md — the managed-policy location: loads
#           first, project-unexcludable, read-only like managed-settings
#   codex   ~/.codex/AGENTS.md; agy ~/.gemini/GEMINI.md; kiro-cli
#           ~/.kiro/steering/AGENTS.md; copilot
#           ~/.copilot/copilot-instructions.md; opencode
#           ~/.config/opencode/AGENTS.md — no system scope, so each
#           resolves through the persistent volume. (Codex's
#           model_instructions_file would *replace* the built-in
#           instructions, so it is not used.)
#
# Symlinks, not copies: a seeded directory is never touched again, and this
# text must change with the image. Absolute, because a relative link would
# have to climb out of the volume.
#
# Each script's own header says what it is for; they ship because an agent would otherwise retype
# them from the instructions.
#
# The image's own programs are named ko-sandbox-*, and the variables it sets for them KO_SANDBOX_*:
# the agent CLIs installed above share /usr/local/bin and the environment, where a bare sandbox-*
# or SANDBOX_* name does not say whose it is. KO_AGENT_SANDBOX_* are the launcher's variables
# (AgentSandboxLauncher.LauncherVariablePrefix).
COPY --chmod=0755 \
    ko-sandbox-jdk-use-proxy ko-sandbox-apt-get ko-sandbox-install-podman ko-sandbox-run-on-host \
    ko-sandbox-egress-check ko-sandbox-clipboard ko-sandbox-text-width ko-sandbox-link-check \
    ko-sandbox-entrypoint \
    /usr/local/bin/
RUN set -eu; for name in xclip xsel wl-paste wl-copy; do ln -s ko-sandbox-clipboard /usr/local/bin/$name; done

# sbt 2 reads its global settings from ~/.config/sbt/2, not ~/.sbt/2, unless SBT_CONFIG_HOME or
# XDG_CONFIG_HOME names another place; the image sets neither. sbt 1 has no rootOutputDirectory,
# so there is no such file for ~/.sbt/1.0.
# nonroot-owned: sbt keeps its staging and zinc directories beside the settings.
RUN install -d -o nonroot -g nonroot /home/nonroot/.config/sbt /home/nonroot/.config/sbt/2
COPY --chown=nonroot:nonroot --chmod=0644 config/sbt/2/ /home/nonroot/.config/sbt/2/

# The image has no Maven, so there is no ${maven.home}/conf to hold this: a project's `./mvnw`
# brings its own, and the user settings are the one file every Maven reads.
# nonroot-owned: Maven keeps its local repository beside it.
RUN install -d -o nonroot -g nonroot /home/nonroot/.m2
COPY --chown=nonroot:nonroot --chmod=0644 m2/settings.xml /home/nonroot/.m2/settings.xml

COPY AGENTS-SANDBOX.md /etc/ko-agent-sandbox/AGENTS.md

RUN set -euxo pipefail; \
    ln -s /etc/ko-agent-sandbox/AGENTS.md /etc/claude-code/CLAUDE.md; \
    ln -s /etc/ko-agent-sandbox/AGENTS.md $KO_SANDBOX_VOLUME_SEED/codex/AGENTS.md; \
    ln -s /etc/ko-agent-sandbox/AGENTS.md $KO_SANDBOX_VOLUME_SEED/antigravity/GEMINI.md; \
    install -d -o nonroot -g nonroot -m 0700 $KO_SANDBOX_VOLUME_SEED/kiro/config/steering; \
    ln -s /etc/ko-agent-sandbox/AGENTS.md $KO_SANDBOX_VOLUME_SEED/kiro/config/steering/AGENTS.md; \
    ln -s /etc/ko-agent-sandbox/AGENTS.md $KO_SANDBOX_VOLUME_SEED/copilot/copilot-instructions.md; \
    ln -s /etc/ko-agent-sandbox/AGENTS.md $KO_SANDBOX_VOLUME_SEED/opencode/config/AGENTS.md


# ---------------------------------------------------------------------------
# Unprivileged runtime user
# ---------------------------------------------------------------------------

# No project directory and no WORKDIR: the launcher mounts the project at its own path, which
# podman creates in the read-only root at create, and starts the session there.
USER nonroot

ENTRYPOINT ["ko-sandbox-entrypoint"]
CMD ["bash"]
