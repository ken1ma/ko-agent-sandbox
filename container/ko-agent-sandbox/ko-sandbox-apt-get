#!/bin/sh
#
# The sandbox's apt-get takes apt-get's actions but unpacks the packages into $HOME, with dependencies resolved.
# A real `apt-get install` can never work on a read-only rootfs as uid 65532, which is why this script exists.
#
#   ko-sandbox-apt-get update           # fetches the package lists, explicitly, exactly as apt-get does
#   ko-sandbox-apt-get install podman   # dependencies arrive too; `podman` is then on PATH
#
# What install does:
# - install runs apt-get with its directories under ~/.local/deb. The image's real dpkg status stays apt's baseline, so
#   apt fetches only what the image lacks. apt still verifies Release signatures against the image's own /etc/apt
#   keyrings.
# - install unpacks the archives this install resolved to. Each new command gets a wrapper in ~/.local/bin, which is
#   already on PATH, and the wrapper sets the library path the command needs.
# - install exports nothing, so the commands work from any shell, script or pipe.
#
# install passes its arguments to apt-get as given, so apt-get's options and package forms (`-o ...`,
# `--no-install-recommends`, `pkg=version`, `pkg:arch`) select packages as stock apt-get's do.
# `update` and `install` are the only actions.
#
# What it is not: an install. No maintainer scripts run, nothing registers with dpkg, and the services, users or
# setuid bits a package expects do not appear. Like everything under ~, the unpacked packages are gone when the
# session ends. If the same program gets installed session after session, tell the user: only the image installs
# the program for good, with one line in the Containerfile.
set -eu

root=$HOME/.local/deb
apt=$root/apt

usage() {
    echo "usage: ${0##*/} update | install PACKAGE..." >&2
    exit 2
}

[ $# -ge 1 ] || usage
action=$1
shift

mkdir -p "$apt/lists/partial" "$apt/cache/archives/partial" "$root" "$HOME/.local/bin"
[ -f "$apt/sources.list" ] \
    || printf 'deb https://deb.debian.org/debian trixie main\n' > "$apt/sources.list"

aptc() {
    apt-get \
        -o Dir::State::Lists="$apt/lists" \
        -o Dir::Cache="$apt/cache" \
        -o Dir::Etc::SourceList="$apt/sources.list" \
        -o Dir::Etc::SourceParts=/dev/null \
        -o Dir::Etc::Preferences=/dev/null \
        -o Dir::Etc::PreferencesParts=/dev/null \
        -o Acquire::Languages=none \
        -o Debug::NoLocking=1 \
        "$@"
}

# apt touches the read-only system cache, and rm complains about /var/cache/apt/archives/partial. The complaint is
# expected and harmless, so the script filters it out rather than leave it to read like a failure.
# The filter reads a file, not a pipe: a pipeline reports its last stage, and apt's own failure must decide.
update_lists() {
    status=0
    # Error-Mode=any: otherwise a failed index fetch is a warning with exit 0. With one configured repository,
    # "ignored, or old ones used instead" means a silent resolve against stale lists.
    aptc update -qq -o APT::Update::Error-Mode=any > "$apt/update.log" 2>&1 || status=$?
    grep -v "/var/cache/apt/archives/partial" "$apt/update.log" >&2 || true
    return $status
}

case $action in
    update)
        [ $# -eq 0 ] || usage
        update_lists
        exit 0
        ;;
    install)
        [ $# -ge 1 ] || usage
        ;;
    *)
        usage
        ;;
esac

# The rest of the script is install. Lists come only from an explicit `update`, exactly as with apt-get. Missing
# lists produce a hint here instead of apt's "Unable to locate package".
if [ -z "$(find "$apt/lists" -maxdepth 1 -name '*Packages*' -print -quit 2>/dev/null)" ]; then
    echo "${0##*/}: no package lists yet — run '${0##*/} update' first" >&2
    exit 1
fi

# --download-only resolves against the image's installed set, the default dpkg status, which stays readable. apt
# therefore fetches only the packages that are actually missing, and their dependencies.
# The output goes through a file for the same reason as in update above. A download that still fails after the
# retries must fail the install here. Otherwise the stranded archive shows only much later, as an unpacked binary
# that fails to load a library it arrived without.
if ! aptc install --download-only -y -o Acquire::Retries=3 "$@" > "$apt/install.log" 2>&1; then
    grep -E "newly installed|^Get:|^Err|^E:" "$apt/install.log" | tail -5 >&2
    # The log moves aside, or a retry that succeeds after a transient failure overwrites the evidence of that failure.
    mv "$apt/install.log" "$apt/install-failed.log"
    echo "${0##*/}: download failed; nothing unpacked (apt output kept: $apt/install-failed.log)" >&2
    exit 1
fi
grep -E "newly installed|^Get:" "$apt/install.log" | tail -1

# apt's simulation of the same install gives the packages and versions this install resolved to. The script writes
# them to $apt/resolved, one "package version" per line.
# - A simulation line reads "Inst demo (1.10 Debian:13/stable [arm64])". The line has "[1.9] " before the
#   parenthesis when the image holds an older version, and "demo:amd64" for the name when the architecture is
#   neither the native one nor "all".
# - The cache outlives the install that filled it, so the cache also holds what a failed or killed download left.
#   Only the archives listed here are unpacked; otherwise a later install of an unrelated package would unpack the
#   leftovers.
# - The output goes through a file once more: a simulation that fails must fail the install, not read as an install
#   that resolved to nothing.
if ! aptc install -s "$@" > "$apt/simulate.log" 2>&1; then
    grep -E "^E:" "$apt/simulate.log" | tail -5 >&2
    echo "${0##*/}: the download succeeded but apt's simulation of the install failed; nothing unpacked" \
        "(apt output kept: $apt/simulate.log)" >&2
    exit 1
fi
sed -n 's/^Inst \([^ ]*\) \(\[[^]]*\] \)\{0,1\}(\([^ ]*\) .*/\1 \3/p' "$apt/simulate.log" > "$apt/resolved"

# The cache is the only record of what was fetched, since nothing registers with dpkg. The script deliberately
# leaves the cache uncleaned: deleting archives would turn every repeated install of the same package into a
# re-download.
# A manifest per package stands in for the ownership database dpkg would have kept. The manifest is filed under the
# name the simulation gives the package, and it names the extracted archive, its version, and every path the archive
# holds.
# - A rerun of the same archive is skipped.
# - Any other version the install resolved to extracts over $root. The loop then deletes the paths the predecessor
#   owned that no manifest lists any more, so no command that only the replaced version shipped stays behind.
# - A path that moved to another package stays. Such a move is a Debian transition, and the other package may well
#   have been extracted first.
# - An older version replaces a newer one the same way: `pkg=version` selects it, and apt reports no downgrade,
#   because apt's baseline, the image's dpkg status, holds neither version.
# - The loop replaces the manifest only once the extraction and the deletions are through. An aborted extraction,
#   or a deletion that an unwritable directory refuses, leaves the old manifest, so a retry deletes what remains
#   instead of skipping the archive as done.
unpacked=$root/.unpacked
mkdir -p "$unpacked"
native=$(dpkg --print-architecture)
for archive in "$apt/cache/archives"/*.deb; do
    [ -e "$archive" ] || continue
    base=${archive##*/}
    package=$(dpkg-deb -f "$archive" Package)
    version=$(dpkg-deb -f "$archive" Version)
    architecture=$(dpkg-deb -f "$archive" Architecture)
    case $architecture in
        "$native"|all) ;;
        *) package=$package:$architecture ;;
    esac
    grep -qxF -- "$package $version" "$apt/resolved" || continue
    manifest=$unpacked/$package
    current_base=
    [ -f "$manifest" ] && IFS= read -r current_base < "$manifest"
    [ "$current_base" = "$base" ] && continue
    files=$(dpkg-deb --fsys-tarfile "$archive" | tar -tf - 2>/dev/null | sed 's#^\./##')
    dpkg-deb -x "$archive" "$root"
    { printf '%s\n%s\n' "$base" "$version"; printf '%s\n' "$files"; } > "$manifest.new"
    if [ -n "$current_base" ]; then
        tail -n +3 "$manifest" | while IFS= read -r path; do
            case "$path" in ''|*/) continue ;; esac
            for other in "$unpacked"/*; do
                [ "$other" != "$manifest" ] && grep -qxF -- "$path" "$other" && continue 2
            done
            rm -f "$root/$path"
        done
    fi
    mv "$manifest.new" "$manifest"
done

# Prints the command that a wrapper written by this script execs, or nothing. The exec line under $root marks this
# script's wrappers, so the image's commands and anything else in ~/.local/bin print nothing.
wrapper_target() {
    sed -n "s|^exec \\($root/[^\"]*\\) \"\$@\"\$|\\1|p" "$1" 2>/dev/null
}

# Each unpacked command gets one wrapper, which scopes LD_LIBRARY_PATH to that process tree instead of exporting it
# globally. Nothing an agent unpacked then shadows libraries for the image's own binaries. The loop leaves alone:
# - a command already on PATH, for the same reason: a dependency chain that happens to include python3 must not
#   change which python3 the session runs;
# - any other file of the command's name in ~/.local/bin, such as a `uv tool` or `cs install` command.
# The loop rewrites this script's own earlier wrappers, so a rerun stays idempotent.
libs="$root/usr/lib/$(uname -m)-linux-gnu:$root/usr/lib:$root/lib"
wrapped=""
skipped=""
for dir in "$root/usr/bin" "$root/usr/sbin" "$root/bin" "$root/sbin"; do
    [ -d "$dir" ] || continue
    for command in "$dir"/*; do
        [ -f "$command" ] && [ -x "$command" ] || continue
        name=${command##*/}
        wrapper=$HOME/.local/bin/$name
        if [ -z "$(wrapper_target "$wrapper")" ] \
            && { [ -e "$wrapper" ] || [ -L "$wrapper" ] || command -v "$name" >/dev/null 2>&1; }; then
            skipped="$skipped $name"
            continue
        fi
        cat > "$wrapper" <<WRAP
#!/bin/sh
export LD_LIBRARY_PATH=$libs\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}
export PATH=$root/usr/bin:$root/usr/sbin:\$PATH
exec $command "\$@"
WRAP
        chmod 0755 "$wrapper"
        wrapped="$wrapped $name"
    done
done

# A wrapper for a command that the replacement above deleted would still answer `command -v`. This loop drops the
# wrappers whose $root target no longer exists.
for wrapper in "$HOME/.local/bin"/*; do
    [ -f "$wrapper" ] || continue
    target=$(wrapper_target "$wrapper")
    [ -n "$target" ] && [ ! -e "$target" ] && rm -f "$wrapper"
done

summary=$(printf '%s' "$wrapped" | tr ' ' '\n' | grep -c . || true)
echo "unpacked under $root; $summary commands wrapped into ~/.local/bin:${wrapped:- (libraries only)}" \
    | cut -c1-200
[ -z "$skipped" ] || echo "already on PATH or in ~/.local/bin, left alone:$skipped" | cut -c1-200
