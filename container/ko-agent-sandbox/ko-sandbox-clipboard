#!/bin/sh
#
# The host clipboard, through the launcher's relay (SECURITY.md, "Clipboard", describes the channel and its limits).
# The image installs this script under the names that Claude Code, Copilot CLI and OpenCode shell out to on Linux:
# xclip, xsel, wl-paste and wl-copy. The script answers only the argument patterns those agents use, and anything
# else is a usage error.
#
# Each call is one transaction: take the lock, write a request line (plus a body for `set`) to the request FIFO,
# and read the whole response FIFO.
# - A missing FIFO means the relay is absent. In a session launched without --clipboard, the call fails at once.
# - In a session launched with --clipboard, the launcher sets KO_AGENT_SANDBOX_CLIPBOARD, and the call waits a short
#   time for the FIFO, since the relay makes the FIFO only once the container runs.
# - A relay that has died leaves the FIFO behind, and the timeouts further down bound the wait for it.
set -eu

dir=/tmp/ko-agent-sandbox/clipboard
if [ -n "${KO_AGENT_SANDBOX_CLIPBOARD:-}" ]; then
  i=0
  while [ ! -p "$dir/req" ] && [ "$i" -lt 100 ]; do i=$((i + 1)); sleep 0.1; done
fi
[ -p "$dir/req" ] || exit 1

case "$(basename "$0")${*:+ $*}" in
  "xclip -selection clipboard -t TARGETS -o") request=types ;;
  "wl-paste -l")                              request=types ;;
  "xclip -selection clipboard -t image/"*)    request="get $4" ;;
  "wl-paste --type image/"*)                  request="get $2" ;;
  "xclip -selection clipboard"|"xclip -selection clipboard -i"|"xsel --clipboard --input"|"wl-copy"|"wl-copy --primary")
                                              request=set ;;
  "wl-copy --type text/plain"|"wl-copy --type text/html")  # copilot's /copy
                                              request=set ;;
  *)
    # The forms each name answers, as the patterns above spell them.
    case "$(basename "$0")" in
      xclip)
        accepted="'xclip -selection clipboard -t TARGETS -o', 'xclip -selection clipboard -t image/<type> -o' and"
        accepted="$accepted 'xclip -selection clipboard [-i]'; it reads no text, so paste text through the terminal" ;;
      wl-paste)
        accepted="'wl-paste -l' and 'wl-paste --type image/<type>'"
        accepted="$accepted; it reads no text, so paste text through the terminal" ;;
      xsel) accepted="'xsel --clipboard --input'" ;;
      *) accepted="'wl-copy', 'wl-copy --primary' and 'wl-copy --type text/plain' or 'text/html'" ;;
    esac
    echo "$0: unsupported arguments: '$*'; this clipboard shim answers $accepted" >&2
    exit 64 ;;
esac

exec 9> "$dir/lock"
flock -w 5 9

if [ "$request" = set ]; then
  body=$(mktemp "$dir/set.XXXXXX")
  trap 'rm -f "$body"' EXIT
  cat > "$body"
  { printf 'set %s\n' "$(wc -c < "$body")"; cat "$body"; } | timeout 5 sh -c "cat > $dir/req"
  # `ok` means the relay set the host clipboard, or paste mode dropped the copy. Any other answer fails the copy
  # here rather than pass a write that never reached the host as done. Such an answer comes from a copy that
  # failed, or from a relay that is gone, which the read's timeout bounds.
  [ "$(timeout 10 cat "$dir/rsp")" = ok ] || exit 1
  exit 0
fi

printf '%s\n' "$request" | timeout 5 sh -c "cat > $dir/req"
timeout 10 cat "$dir/rsp"
