<?xml version="1.0" encoding="UTF-8"?>
<!--
  By default Maven takes its proxy from this file alone:
  - Maven's resolver reads no HTTPS_PROXY.
  - The resolver reads the JVM's https.proxyHost, from conf/net.properties or a -D option, only under
    -Daether.connector.http.useSystemProperties=true. The run-on-host runner passes that option, and a
    project's `./mvnw` does not.
  A build without this entry fails resolving its first plugin with "Temporary failure in name resolution".

  The address is literal because Maven refuses a property in <port> ("must be an integer").
  AgentSandboxLauncherTest holds the address equal to the launcher's. nonProxyHosts is the session's NO_PROXY.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <proxies>
    <proxy>
      <id>ko-agent-sandbox-egress</id>
      <protocol>https</protocol>
      <host>egress-proxy</host>
      <port>3128</port>
      <nonProxyHosts>localhost|127.0.0.1</nonProxyHosts>
    </proxy>
  </proxies>
</settings>
