# Each non-interactive bash under Codex loads this file through BASH_ENV, which /etc/codex/config.toml sets.
if [ -n "${KO_SANDBOX_TOOLCHAIN_PATH-}" ]; then
    case ":${PATH}:" in
        *":${KO_SANDBOX_TOOLCHAIN_PATH}:"*) ;;
        *) PATH="${KO_SANDBOX_TOOLCHAIN_PATH}:${PATH}" ;;
    esac
    export PATH
fi
