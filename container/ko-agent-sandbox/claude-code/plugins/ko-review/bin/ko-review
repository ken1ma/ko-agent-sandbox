#!/usr/bin/env -S python3 -I
"""Runs one stateful review cycle for the author of a change, the agent that made it.

A cycle is one reviewer thread, Codex's or Claude Code's: `start` opens it with a fresh review,
`continue` sends the author's fixes or reasons for disagreeing to the same thread, and `verify`
confirms the approval covers the current working tree. State lives in the project's persistent
volume; doc/ko-review.md describes the design and command output.
"""

import argparse
import ctypes
import datetime
import fcntl
import hashlib
import json
import math
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import tomllib
import secrets
from pathlib import Path


PLUGIN_ROOT = Path(__file__).resolve().parent.parent
SCHEMA_VERSION = 2
PLUGIN_VERSION = json.loads((PLUGIN_ROOT / ".claude-plugin/plugin.json").read_text())["version"]
RESULT_SCHEMA = PLUGIN_ROOT / "schemas/review-result.schema.json"
DISPOSITIONS = {"APPROVED", "CHANGES_REQUESTED", "USER_DECISION_REQUIRED"}
SEVERITIES = {"critical", "high", "medium", "low"}
TERMINAL = {"USER_DECISION_REQUIRED", "LOOP_LIMIT_REACHED"}
DEFAULT_MAX_ROUNDS = 12
DEFAULT_TIMEOUT_SECONDS = 3600
# Python turns only SIGINT into an exception; these are raised as one below so that a terminated
# helper still kills the reviewer and reverts the review's state.
TERMINATING_SIGNALS = (signal.SIGTERM, signal.SIGHUP)
PR_SET_CHILD_SUBREAPER = 36  # prctl(2)


class ReviewError(Exception):
    def __init__(self, code, message, **detail):
        super().__init__(message)
        self.code = code
        self.message = message
        self.detail = detail

    def to_json(self):
        return {"code": self.code, "message": self.message, **self.detail}


class GitFailure(ReviewError):
    """A Git command failed: recoverable where a snapshot is optional, unlike an interruption."""

    def __init__(self, message, **detail):
        super().__init__("GIT_FAILED", message, **detail)


class ReviewerError(ReviewError):
    """The reviewer, not the helper, failed: the error names it so that the skill's advice fits."""

    def __init__(self, reviewer, code, message, **detail):
        super().__init__(code, message, reviewer=reviewer.name, **detail)


CURRENT_REVIEW = None  # the review a command has created or opened, named in its failures


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def git(root, *args, check=True):
    completed = subprocess.run(
        ["git", *args], cwd=root, capture_output=True, check=False,
    )
    if check and completed.returncode != 0:
        raise GitFailure("git " + " ".join(args) + " failed", stderr=completed.stderr.decode(errors="replace"))
    return completed


def repository_root(directory):
    completed = git(directory, "rev-parse", "--show-toplevel", check=False)
    if completed.returncode != 0:
        raise ReviewError(
            "NOT_A_GIT_REPOSITORY",
            f"{directory} is not a Git working tree, and a review keeps each round's tree and its approval in"
            " Git. Make it one, then retry:\n\n"
            "git init\n"
            "git commit --allow-empty -m \"Start of the review\"\n\n"
            "The files stay uncommitted, so the review covers them all; a .gitignore keeps build outputs and"
            " secrets out of it. The .git directory can be removed after the review; the review's record under"
            " it goes with it.",
        )
    return Path(completed.stdout.decode().rstrip("\n")).resolve()


def file_digest(path):
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        for chunk in iter(lambda: stream.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest().encode()


def worktree_entry(root, path):
    absolute = root / path.decode("utf-8", "surrogateescape")
    try:
        status = os.lstat(absolute)
    except FileNotFoundError:
        return b"missing"
    if stat.S_ISLNK(status.st_mode):
        return b"link\0" + os.readlink(absolute).encode("utf-8", "surrogateescape")
    if stat.S_ISDIR(status.st_mode):
        if (absolute / ".git").exists():
            # A submodule's status record carries dirty flags, not what changed; a nested
            # repository is one untracked directory. Each is digested as a tree of its own.
            return b"repository\0" + observe(absolute)["digest"].encode()
        return b"dir"
    if stat.S_ISREG(status.st_mode):
        # git's status record carries no mode for an untracked file
        executable = b"x" if status.st_mode & 0o111 else b"-"
        return b"file\0" + executable + b"\0" + file_digest(absolute)
    return b"other"


def status_records(root):
    """Every path whose working tree or index differs from HEAD, as `git status` reports it.

    Renames are off so a moved file appears as its deletion and addition. Each record carries
    the index and HEAD object ids and the modes, so staged content is part of the digest without
    reading the index."""
    output = git(
        root, "status", "--porcelain=v2", "-z", "--untracked-files=all", "--no-renames",
        "--ignore-submodules=none",
    ).stdout
    records = []
    fields = [field for field in output.split(b"\0") if field]
    index = 0
    while index < len(fields):
        record = fields[index]
        index += 1
        kind = record[:1]
        if kind == b"1":
            path = record.split(b" ", 8)[8]
        elif kind == b"2":
            path = record.split(b" ", 9)[9]
            index += 1  # the rename's original path, a record of its own
        elif kind == b"u":
            path = record.split(b" ", 10)[10]
        elif kind in (b"?", b"!"):
            path = record[2:]
        else:
            raise GitFailure("unrecognized git status record", record=record.decode(errors="replace"))
        records.append((path, record))
    records.sort()
    return records


def observe(root):
    """One scan of the checkout: HEAD, the status records, and every reviewable file's raw entry.

    The status records carry the index's and HEAD's object ids and modes per changed path. The
    manifest maps every file Git would review, tracked or untracked and not ignored, nested
    repositories recursively, to a hash of its raw working-tree content with its executable bit,
    or of its symlink target; an absent path is left out, so staging a deletion or a rename changes
    nothing there. Raw content, because `git status` calls a file clean when its content after the
    clean filter matches the index, so the records alone would miss a change a filter strips. The
    content digest is the manifest's; the digest is HEAD, the records and the content together."""
    head = git(root, "rev-parse", "--verify", "--quiet", "HEAD", check=False)
    head_id = head.stdout.decode().strip() if head.returncode == 0 else "unborn"
    listed = git(root, "ls-files", "-z", "--cached", "--others", "--exclude-standard").stdout
    manifest = {}
    repositories = []  # submodules, listed by the index as gitlinks, and untracked nested repositories
    content = hashlib.sha256()
    # An untracked nested repository is listed as `dir/`, a gitlink as `dir`: one path either way.
    for path in sorted(set(field.rstrip(b"/") for field in listed.split(b"\0") if field)):
        entry = worktree_entry(root, path)
        if entry != b"missing":
            entry_hash = hashlib.sha256(entry).hexdigest()
            manifest[path.decode("utf-8", "surrogateescape")] = entry_hash
            content.update(path + b"\0" + entry_hash.encode() + b"\0")
            if entry.startswith(b"repository\0"):
                repositories.append(path.decode("utf-8", "surrogateescape"))
    content_digest = "sha256:" + content.hexdigest()
    digest = hashlib.sha256()
    digest.update(b"HEAD " + head_id.encode() + b"\n")
    for path, record in status_records(root):
        digest.update(record + b"\0")
    digest.update(content_digest.encode() + b"\n")
    return {
        "head": head_id, "digest": "sha256:" + digest.hexdigest(), "contentDigest": content_digest,
        "manifest": manifest, "repositories": repositories,
    }


def manifest_changes(before, after):
    """The paths whose entry differs between two manifests, sorted."""
    return sorted(
        path for path in set(before) | set(after) if before.get(path) != after.get(path)
    )


def tree_of_worktree(root, index):
    """The working tree written as a Git tree object through the scratch index `index`.

    The scratch index starts as a copy of the user's index entries, so the tracked paths are the
    checkout's, staged additions and removals included, whatever the ignore rules say of them;
    `git add -A` then applies the ignore rules to untracked files only. The user's index, HEAD
    and files are untouched."""
    env = {**os.environ, "GIT_INDEX_FILE": str(index)}
    index.unlink(missing_ok=True)  # git refuses an empty index file; it accepts an absent one
    try:
        entries = git(root, "ls-files", "-z", "--stage").stdout
        for command, stdin in (
            (["git", "update-index", "-z", "--index-info"], entries),
            (["git", "add", "-A", "--", "."], None),
            (["git", "write-tree"], None),
        ):
            completed = subprocess.run(command, cwd=root, env=env, input=stdin, capture_output=True, check=False)
            if completed.returncode != 0:
                raise GitFailure(
                    " ".join(command) + " failed while writing the working tree as a Git tree",
                    stderr=completed.stderr.decode(errors="replace")[-500:],
                )
        return completed.stdout.decode().strip()
    finally:
        index.unlink(missing_ok=True)


def tree_of_index(root, index):
    """The user's index written as a Git tree object through a scratch copy, the index untouched."""
    env = {**os.environ, "GIT_INDEX_FILE": str(index)}
    index.unlink(missing_ok=True)
    try:
        entries = git(root, "ls-files", "-z", "--stage").stdout
        for command, stdin in ((["git", "update-index", "-z", "--index-info"], entries), (["git", "write-tree"], None)):
            completed = subprocess.run(command, cwd=root, env=env, input=stdin, capture_output=True, check=False)
            if completed.returncode != 0:
                raise GitFailure(
                    " ".join(command) + " failed while writing the index as a Git tree",
                    stderr=completed.stderr.decode(errors="replace")[-500:],
                )
        return completed.stdout.decode().strip()
    finally:
        index.unlink(missing_ok=True)


def snapshot(review, round_number, observation):
    """The working tree as a Git tree object, held by refs/ko-review/<review>/round-NNN.

    A read-only Git directory, a linked worktree's, refuses the writes; the round then has no
    snapshot and the digest alone binds it. `excludes` names the nested repositories, found by the
    observation, whose contents a tree cannot hold; the digest covers them."""
    ref = f"refs/ko-review/{review.id}/round-{round_number:03d}"
    taken = {"round": round_number, "ref": None, "tree": None, "excludes": observation["repositories"]}
    try:
        tree = tree_of_worktree(review.root, review.round_path(round_number, "index"))
        git(review.root, "update-ref", ref, tree)
    except GitFailure as ex:
        return {**taken, "error": (ex.message + " " + str(ex.detail.get("stderr", "")))[-300:]}
    return {**taken, "ref": ref, "tree": tree}


def attach_transcript(review, taken, text):
    """The round's transcript as a tag object on the round's ref, which then peels to the tree:
    the ref's `%(contents)` is the transcript, `git diff` between refs still compares trees, and
    `git tag` lists none of it. The tagger is the helper, since neither the user nor the reviewer wrote the
    whole message. Without a snapshot there is no ref to carry it. A failure leaves the ref on the
    tree and its diagnostic in the snapshot's `transcriptError`, which the JSON output carries."""
    if not taken.get("ref"):
        return None
    tagged = datetime.datetime.now().astimezone()
    header = (
        f"object {taken['tree']}\ntype tree\ntag round-{taken['round']:03d}\n"
        f"tagger ko-review <ko-review@ko-agent-sandbox> {int(tagged.timestamp())} {tagged.strftime('%z')}\n\n"
    )
    try:
        written = subprocess.run(
            ["git", "mktag"], cwd=review.root, input=(header + text.rstrip("\n") + "\n").encode(),
            capture_output=True, check=False,
        )
        if written.returncode != 0:
            raise GitFailure("git mktag failed", stderr=written.stderr.decode(errors="replace")[-300:])
        tag = written.stdout.decode().strip()
        git(review.root, "update-ref", taken["ref"], tag)
    except GitFailure as ex:
        taken["transcriptError"] = (ex.message + " " + str(ex.detail.get("stderr", ""))).strip()[-300:]
        return None
    return tag


def snapshot_refs(review):
    completed = git(review.root, "for-each-ref", "--format=%(refname)", f"refs/ko-review/{review.id}/", check=False)
    return completed.stdout.decode().split() if completed.returncode == 0 else []


def resolve_base(root, ref):
    completed = git(root, "rev-parse", "--verify", "--quiet", ref + "^{commit}", check=False)
    if completed.returncode != 0:
        raise ReviewError("BASE_UNKNOWN", f"{ref} is not a commit in this repository")
    return {"ref": ref, "commit": completed.stdout.decode().strip()}


def state_root():
    """Inside ko-agent-sandbox the project's persistent volume; elsewhere the user's state directory."""
    override = os.environ.get("KO_REVIEW_STATE")
    if override:
        return Path(override)
    volume = Path.home() / "persistent-volume"
    if volume.is_dir():
        return volume / "ko-review"
    return Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "ko-review"


def repository_dir(root):
    directory = state_root() / "repositories" / hashlib.sha256(str(root).encode()).hexdigest()
    directory.mkdir(parents=True, exist_ok=True)
    marker = directory / "repository.json"
    if not marker.exists():
        write_json_atomically(marker, {"repository": str(root)})
    return directory


def write_json_atomically(path, data):
    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    try:
        with os.fdopen(descriptor, "w") as stream:
            json.dump(data, stream, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except BaseException:
        os.unlink(temporary)
        raise


class Review:
    def __init__(self, root, review_id):
        self.root = root
        self.id = review_id
        self.dir = repository_dir(root) / "reviews" / review_id
        self.rounds = self.dir / "rounds"
        self.state_path = self.dir / "state.json"
        self.journal_path = self.dir / "journal.jsonl"
        self.lock_path = self.dir / "review.lock"
        self.state = None
        self.lock_file = None

    @staticmethod
    def open(root, review_id, check_readable=True):
        """The review locked, then loaded: what it says is what the command acts on."""
        review = Review(root, review_id)
        if not review.state_path.exists():
            raise ReviewError("UNKNOWN_REVIEW", f"no review {review_id} for {root}")
        review.lock()
        return review.load(check_readable)

    @property
    def reviewer(self):
        return REVIEWERS[self.state["reviewer"]]

    @staticmethod
    def create(root, max_rounds, reviewer):
        """A review named by its local start time, so refs and directories list in order, plus a
        random suffix; a name already taken, within one minute, is drawn again."""
        global CURRENT_REVIEW
        while True:
            started = datetime.datetime.now().astimezone().strftime("%Y-%m-%d-%H%M")
            review = Review(root, f"{started}-{secrets.token_hex(4)}")
            try:
                review.rounds.mkdir(parents=True)
                break
            except FileExistsError:
                continue
        CURRENT_REVIEW = review
        review.state = {
            "schemaVersion": SCHEMA_VERSION,
            "reviewId": review.id,
            "repository": str(root),
            "reviewer": reviewer.name,
            "reviewerVersion": reviewer.version(),
            "status": "NEW",
            "round": 0,
            "maxRounds": max_rounds,
            "threadId": None,
            "pluginVersion": PLUGIN_VERSION,
            # the author's Claude Code session or Codex thread, if any
            "authorSessionId": os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CODEX_THREAD_ID") or None,
            "createdAt": now(),
            "updatedAt": None,
            "base": None,
            "instructions": None,
            "model": None,
            "effort": None,
            "snapshots": [],
            "lastReviewed": None,
            "approved": None,
            "lastError": None,
        }
        review.save()
        return review

    def load(self, check_readable=True):
        """With `check_readable` off, for `list` and `delete`: whatever the state holds, `{}` when it
        cannot be read as a JSON object."""
        global CURRENT_REVIEW
        if not self.state_path.exists():
            raise ReviewError("UNKNOWN_REVIEW", f"no review {self.id} for {self.root}")
        try:
            self.state = json.loads(self.state_path.read_text())
        except (OSError, ValueError):
            self.state = None
        if not isinstance(self.state, dict):
            self.state = {}
            if check_readable:
                raise ReviewError(
                    "STATE_IO_FAILED",
                    f"{self.state_path} cannot be read as a JSON object: `ko-review delete {self.id}` removes the"
                    " review",
                )
            return self
        CURRENT_REVIEW = self
        if not check_readable:
            return self
        if self.state.get("schemaVersion") != SCHEMA_VERSION:
            raise ReviewError(
                "STATE_IO_FAILED",
                f"{self.state_path} has schemaVersion {self.state.get('schemaVersion')}, and this helper reads"
                f" {SCHEMA_VERSION}: `ko-review delete {self.id}` removes the review",
            )
        if self.state.get("reviewer") not in REVIEWERS:
            raise ReviewError(
                "REVIEWER_UNSUPPORTED",
                f"review {self.id} is a {self.state.get('reviewer')} review; this helper runs " + ", ".join(REVIEWERS),
            )
        return self

    def save(self):
        self.state["updatedAt"] = now()
        write_json_atomically(self.state_path, self.state)

    def lock(self):
        self.lock_file = open(self.lock_path, "a")
        try:
            fcntl.flock(self.lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ReviewError("REVIEW_BUSY", f"another command holds review {self.id}; retry when it finishes")

    def journal(self, entry):
        entry = {"seq": self.journal_length() + 1, "at": now(), **entry}
        with open(self.journal_path, "a") as stream:
            stream.write(json.dumps(entry) + "\n")
            stream.flush()
            os.fsync(stream.fileno())

    def journal_entries(self):
        if not self.journal_path.exists():
            return []
        return [json.loads(line) for line in self.journal_path.read_text().splitlines() if line.strip()]

    def round_transcript(self, round_number):
        """The round's journal entries as Markdown, headed by the review and the round."""
        entries = [entry for entry in self.journal_entries() if entry.get("round") == round_number]
        rendered = render_entries(self.reviewer, entries, False)
        return "\n".join([f"# Review {self.id}, round {round_number}", "", *rendered])

    def journal_length(self):
        if not self.journal_path.exists():
            return 0
        with open(self.journal_path, "rb") as stream:
            return sum(1 for line in stream if line.strip())

    def round_path(self, round_number, suffix):
        return self.rounds / f"{round_number:03d}-{suffix}"

    def manifest_of(self, round_number):
        path = self.round_path(round_number, "manifest.json")
        return json.loads(path.read_text()) if path.exists() else None

    def freshness(self, observation=None):
        """Whether the approval covers the current tree, and if not, why not.

        By digest first. When the digest moved with HEAD or the index, as after the user stages or
        commits the reviewed changes, the approval holds if the files' raw content is still the
        approved one and the index, written as a tree, equals the approved snapshot's tree, so that
        nothing unreviewed is staged. A changed HEAD alone is therefore never a reason when the
        round has a snapshot.

        Without a snapshot there is no approved tree to compare the index with, and a changed HEAD
        or index is itself a reason."""
        observation = observation or observe(self.root)
        approved = self.state.get("approved")
        fresh = approved is not None and approved["worktreeDigest"] == observation["digest"]
        reasons = []
        if not fresh and approved:
            manifest = self.manifest_of(approved["round"])
            if approved.get("contentDigest") != observation["contentDigest"]:
                paths = manifest_changes(manifest, observation["manifest"]) if manifest is not None else []
                reasons.append({"reason": "working files changed", "paths": paths})
            elif approved.get("tree"):
                try:
                    index_tree = tree_of_index(self.root, self.dir / f"verify-index.{os.getpid()}")
                    if index_tree == approved["tree"]:
                        fresh = True
                    else:
                        staged = git(self.root, "diff-tree", "-r", "-z", "--name-only", approved["tree"], index_tree)
                        paths = sorted(
                            field.decode("utf-8", "surrogateescape") for field in staged.stdout.split(b"\0") if field
                        )
                        reasons.append({"reason": "unreviewed content staged", "paths": paths})
                except GitFailure as ex:
                    reasons.append({"reason": "the index could not be compared: " + ex.message, "paths": []})
            else:
                reasons.append({
                    "reason": "HEAD or the index changed, and the round has no snapshot tree to compare with",
                    "paths": [],
                })
        if approved is None and self.state.get("approvalCleared"):
            reasons.append({"reason": self.state["approvalCleared"]["reason"], "paths": []})
        status = self.state["status"]
        if status == "APPROVED" and not fresh:
            status = "STALE_APPROVAL"
        return observation, fresh, status, reasons

    def activity(self):
        """What a round in progress shows: where its events land, and when the last one was
        received, which is not proof that the reviewer is still working."""
        if self.state["status"] != "REVIEWING":
            return None
        events = self.round_path(self.state["round"], self.reviewer.name + ".jsonl")
        last = None
        if events.exists():
            lines = [line for line in events.read_bytes().split(b"\n") if line.strip()]
            if lines:
                try:
                    event = json.loads(lines[-1])
                except ValueError:
                    event = None
                kind = event.get("type") if isinstance(event, dict) else None
                received = datetime.datetime.fromtimestamp(events.stat().st_mtime, datetime.timezone.utc)
                last = {"type": kind, "receivedAt": received.isoformat(timespec="seconds")}
        started = self.state.get("turnStartedAt")
        elapsed = None
        if started:
            since = datetime.datetime.now(datetime.timezone.utc) - datetime.datetime.fromisoformat(started)
            elapsed = int(since.total_seconds())
        return {
            "round": self.state["round"], "eventsPath": str(events), "turnStartedAt": started,
            "elapsedSeconds": elapsed, "lastEventReceived": last,
        }

    def inspect_lines(self):
        """Command lines for the user to see how the review went; the skill relays them at the end."""
        lines = [f"ko-review export {self.id}  # the transcript, one section per round"]
        snapshots = [entry for entry in self.state.get("snapshots", []) if entry.get("ref")]
        if snapshots and snapshots[-1].get("tag"):
            last = snapshots[-1]["ref"]
            lines.append(f"git for-each-ref --format='%(contents)' {last}  # the last round's transcript")
        if len(snapshots) >= 2:
            lines.append(f"git diff {snapshots[0]['ref']} {snapshots[-1]['ref']}  # what changed during the review")
        approved = self.state.get("approved")
        if approved and approved.get("ref"):
            lines.append(f"ko-review diff {self.id}  # your tree against the approved one")
        lines += [
            "ko-review list  # this checkout's reviews, by id",
            f"ko-review delete {self.id}  # the review's state and refs, once you no longer need them",
        ]
        return lines

    def summary(self, observation=None):
        observation, fresh, status, reasons = self.freshness(observation)
        return {
            "reviewId": self.id,
            "repository": str(self.root),
            "reviewer": self.state["reviewer"],
            "status": self.state["status"],
            "effectiveStatus": status,
            "round": self.state["round"],
            "maxRounds": self.state["maxRounds"],
            "instructions": self.state.get("instructions"),
            "base": self.state.get("base"),
            "model": self.state.get("model"),
            "effort": self.state.get("effort"),
            "snapshots": self.state.get("snapshots", []),
            "threadId": self.state["threadId"],
            "lastReviewed": self.state["lastReviewed"],
            "approved": self.state["approved"],
            "approvalFresh": fresh,
            "staleReasons": reasons if status == "STALE_APPROVAL" else [],
            "activity": self.activity(),
            "currentHead": observation["head"],
            "currentWorktreeDigest": observation["digest"],
            "lastError": self.state["lastError"],
            "createdAt": self.state["createdAt"],
            "updatedAt": self.state["updatedAt"],
            "statePath": str(self.state_path),
            "journalPath": str(self.journal_path),
            "inspect": self.inspect_lines(),
        }


def program_version(program):
    try:
        return subprocess.run([program, "--version"], capture_output=True, text=True, check=False).stdout.strip()
    except FileNotFoundError:
        return None


class Codex:
    """Codex CLI as the reviewer: `codex exec` and `codex exec resume`, in the JSONL event stream."""

    name = "codex"
    display = "Codex"
    thread_event = "thread.started"
    # Both hosts: a ChatGPT login talks to chatgpt.com, an API key to api.openai.com.
    hosts = ("api.openai.com", "chatgpt.com")
    lost_thread = "no rollout found"
    sign_in_advice = "run `codex` in this project's sandbox, sign in, and retry"

    def version(self):
        return program_version("codex")

    def signed_in(self):
        """Codex knows its credential stores (auth.json or the OS keyring); the helper does not."""
        status = subprocess.run(["codex", "login", "status"], capture_output=True, text=True, check=False, timeout=60)
        return status.returncode == 0, (status.stdout + status.stderr).strip()[-500:]

    def command(self, state, resume_id, result_path):
        command = ["codex", "exec"]
        if resume_id is not None:
            command += ["resume", resume_id]
        if state.get("model"):
            command += ["--model", state["model"]]
        if state.get("effort"):
            command += ["-c", "model_reasoning_effort=" + json.dumps(state["effort"])]
        return command + [
            "--json", "--output-schema", str(RESULT_SCHEMA), "--output-last-message", str(result_path), "-",
        ]

    def environment(self, state):
        return None  # the helper's own

    def check_choice(self, state):
        pass

    def thread_id(self, event):
        if event.get("type") == "thread.started" and isinstance(event.get("thread_id"), str):
            return event["thread_id"]
        return None

    def failed(self, event):
        return event.get("type") in ("turn.failed", "error")

    def failure_text(self, event):
        error = event.get("error", event.get("message"))
        text = error.get("message") if isinstance(error, dict) else error
        return text if isinstance(text, str) else json.dumps(error)

    def final_result(self, events, result_path):
        """The final message `--output-last-message` wrote, or None."""
        return result_path.read_text() if result_path.exists() else None

    def defaults(self, root):
        return codex_defaults(root)


class Claude:
    """Claude Code as the reviewer: `claude -p` and `claude -p --resume`, in the stream-json events.

    Not `--bare`, which accepts only an API key: the print-mode session runs under the managed
    settings and the project's CLAUDE.md, with the user's, project's and local settings files, the
    slash commands and every MCP server left out. `--permission-prompts none` denies every tool a
    permission prompt would gate, so outside a bypass-permissions policy the reviewer can only read
    files and run the git commands listed; inside one, the digest check is what enforces reading
    only, as for Codex."""

    name = "claude"
    display = "Claude"
    thread_event = "system init"
    # Model traffic, and the OAuth token refresh a claude.ai login makes.
    hosts = ("api.anthropic.com", "platform.claude.com")
    lost_thread = "no conversation found with session id"
    sign_in_advice = "run `claude` in this project's sandbox, sign in with /login, and retry"
    tools = "Bash,Read,Grep,Glob,WebFetch,WebSearch"
    allowed_tools = (
        "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git status:*)", "Bash(git ls-files:*)",
        "Bash(git blame:*)", "Bash(git grep:*)", "WebFetch", "WebSearch",
    )

    def version(self):
        return program_version("claude")

    def signed_in(self):
        status = subprocess.run(
            ["claude", "auth", "status", "--json"], capture_output=True, text=True, check=False, timeout=60,
        )
        text = (status.stdout + status.stderr).strip()[-500:]
        try:
            logged_in = json.loads(status.stdout).get("loggedIn")
        except (ValueError, AttributeError):
            logged_in = None
        return (status.returncode == 0 if logged_in is None else bool(logged_in)), text

    def command(self, state, resume_id, result_path):
        command = ["claude", "-p"]
        if resume_id is not None:
            command += ["--resume", resume_id]
        if state.get("model"):
            command += ["--model", state["model"]]
        if state.get("effort"):
            command += ["--effort", state["effort"]]
        return command + [
            "--verbose", "--output-format", "stream-json", "--json-schema", RESULT_SCHEMA.read_text(),
            "--setting-sources", "", "--disable-slash-commands", "--strict-mcp-config", "--permission-prompts", "none",
            "--tools", self.tools, "--allowedTools", *self.allowed_tools,
        ]

    def environment(self, state):
        """`CLAUDE_CODE_EFFORT_LEVEL` overrides `--effort` (code.claude.com/docs/en/env-vars), so an
        inherited one would run every round at its level while the review records the chosen one."""
        if not state.get("effort"):
            return None
        return {**os.environ, "CLAUDE_CODE_EFFORT_LEVEL": state["effort"]}

    def check_choice(self, state):
        """A managed `env` block replaces the variable `environment` sets, so the effort such a block
        sets is the only one the review can record truthfully."""
        managed_effort, source = claude_managed_variable("CLAUDE_CODE_EFFORT_LEVEL")
        if managed_effort and state.get("effort") and managed_effort != state["effort"]:
            raise ReviewerError(
                self, "REVIEWER_CHOICE_REFUSED",
                f"{source} sets CLAUDE_CODE_EFFORT_LEVEL to {managed_effort}, which Claude Code applies whatever"
                f" the review chooses: start the review with --effort {managed_effort} or without --effort",
            )

    def thread_id(self, event):
        if event.get("type") == "system" and event.get("subtype") == "init" \
                and isinstance(event.get("session_id"), str):
            return event["session_id"]
        return None

    def failed(self, event):
        # An API error can end a print-mode run with exit status 0 and the error in the result
        # (anthropics/claude-code#79500), so the result object, not the status, says whether it failed.
        return event.get("type") == "result" and (event.get("is_error") or event.get("subtype") != "success")

    def failure_text(self, event):
        errors = event.get("errors")
        if isinstance(errors, list) and errors:
            return "; ".join(str(error) for error in errors)
        return event.get("result") if isinstance(event.get("result"), str) else event.get("subtype")

    def final_result(self, events, result_path):
        """The `structured_output` of the result event, kept in the round's result file, or None."""
        for event in reversed(events):
            if event.get("type") == "result" and event.get("structured_output") is not None:
                text = json.dumps(event["structured_output"])
                result_path.write_text(text)
                return text
        return None

    def defaults(self, root):
        return claude_defaults(root)


REVIEWERS = {reviewer.name: reviewer for reviewer in (Codex(), Claude())}


def check_signed_in(reviewer):
    if shutil.which(reviewer.name) is None:
        raise ReviewerError(reviewer, "REVIEWER_FAILED", f"{reviewer.name} is not on PATH")
    signed_in, status = reviewer.signed_in()
    if not signed_in:
        raise ReviewerError(
            reviewer, "REVIEWER_AUTH_FAILED", f"{reviewer.name} is not signed in: {reviewer.sign_in_advice}",
            loginStatus=status,
        )


def hosts_allowed(reviewer):
    """None outside the sandbox; otherwise whether the ruleset the launcher exports allows one of the
    reviewer's hosts."""
    ruleset = os.environ.get("KO_AGENT_SANDBOX_EGRESS_RULESET")
    if not ruleset:
        return None
    return any(f"allow https://{host}/" in ruleset for host in reviewer.hosts)


def check_egress(reviewer):
    if hosts_allowed(reviewer) is False:
        raise ReviewerError(
            reviewer, "REVIEWER_EGRESS_DENIED",
            f"the egress ruleset allows none of {', '.join(reviewer.hosts)}: relaunch the session under an egress"
            " profile that allows both providers, normally the default, and retry",
            profile=os.environ["KO_AGENT_SANDBOX_EGRESS_RULESET"].splitlines()[0],
        )


def egress_diagnostics(reviewer):
    checker = shutil.which("ko-sandbox-egress-check")
    if checker is None:
        return None
    lines = []
    for host in reviewer.hosts:
        completed = subprocess.run([checker, host], capture_output=True, text=True, check=False, timeout=60)
        lines.extend((completed.stdout + completed.stderr).splitlines())
    return lines


RESULT_KEYS = {"disposition", "summary", "findings", "userDecision"}
FINDING_KEYS = {"id", "severity", "location", "description", "evidence"}
USER_DECISION_KEYS = {"issue", "reviewerPosition", "whyTechnicalEvidenceCannotDecide", "decisionRequested"}


def validate_result(result):
    """The checks the schema states, applied to what the reviewer returned: the schema option asks
    the model for the shape but the helper decides."""
    if not isinstance(result, dict):
        return "result is not an object"
    if set(result) != RESULT_KEYS:
        return "result keys are not exactly " + ", ".join(sorted(RESULT_KEYS))
    if not isinstance(result["disposition"], str) or result["disposition"] not in DISPOSITIONS:
        return "disposition is not one of " + ", ".join(sorted(DISPOSITIONS))
    if not isinstance(result["summary"], str):
        return "summary is not a string"
    findings = result["findings"]
    if not isinstance(findings, list):
        return "findings is not an array"
    for finding in findings:
        if not isinstance(finding, dict) or set(finding) != FINDING_KEYS:
            return "a finding's keys are not exactly " + ", ".join(sorted(FINDING_KEYS))
        if not isinstance(finding["id"], str):
            return "a finding's id is not a string"
        if not isinstance(finding["severity"], str) or finding["severity"] not in SEVERITIES:
            return f"finding {finding['id']} has no severity"
        if finding["location"] is not None and not isinstance(finding["location"], str):
            return f"finding {finding['id']}: location is neither a string nor null"
        if not all(isinstance(finding[key], str) for key in ("description", "evidence")):
            return f"finding {finding['id']}: description and evidence must be strings"
    decision = result["userDecision"]
    if result["disposition"] == "USER_DECISION_REQUIRED":
        if not isinstance(decision, dict) or set(decision) != USER_DECISION_KEYS \
                or not all(isinstance(value, str) for value in decision.values()):
            return "USER_DECISION_REQUIRED without a complete userDecision"
    elif decision is not None:
        return "userDecision given without USER_DECISION_REQUIRED"
    if result["disposition"] == "APPROVED" and findings:
        return "APPROVED with findings"
    return None


def reviewer_said(reviewer, stderr, events):
    """The reviewer's own words on its failure, such as a usage limit and when it resets: its last
    failure event's message, else the last line of its stderr."""
    for event in reversed(events):
        if reviewer.failed(event):
            text = reviewer.failure_text(event)
            if isinstance(text, str) and text.strip():
                return text.strip()
    lines = [line.strip() for line in stderr.splitlines() if line.strip()]
    return lines[-1] if lines else None


def reviewer_failed(reviewer, summary, stderr, events, /, **detail):
    said = reviewer_said(reviewer, stderr, events)
    return ReviewerError(reviewer, "REVIEWER_FAILED", f"{summary}: {said}" if said else summary, **detail)


def classify_failure(reviewer, returncode, stderr, events):
    failures = [event for event in events if reviewer.failed(event)]
    messages = [json.dumps(reviewer.failure_text(event)) for event in failures]
    text = stderr + "\n" + "\n".join(messages)
    lowered = text.lower()
    detail = {"exitStatus": returncode, "stderr": stderr[-2000:], "events": messages[-5:]}
    if returncode < 0:
        return ReviewerError(reviewer, "TURN_INTERRUPTED", f"{reviewer.name} ended by signal {-returncode}", **detail)
    if reviewer.lost_thread in lowered:
        return ReviewerError(
            reviewer, "REVIEWER_FAILED", f"{reviewer.name} no longer has this review's thread; start a new review",
            **detail,
        )
    if re.search(r"not logged in|login required|unauthorized|401|refresh token|reauthenticate|/login", lowered):
        return ReviewerError(
            reviewer, "REVIEWER_AUTH_FAILED", f"{reviewer.name} is not signed in: {reviewer.sign_in_advice}", **detail,
        )
    if re.search(r"403|proxy|connect tunnel|tls|network|dns|connection refused|timed out", lowered):
        return ReviewerError(
            reviewer, "REVIEWER_EGRESS_DENIED",
            f"{reviewer.name} could not reach its provider; the diagnostics show what the proxy answered",
            egressCheck=egress_diagnostics(reviewer), **detail,
        )
    return reviewer_failed(reviewer, f"{reviewer.name} failed", stderr, events, **detail)


def adopt_orphans(adopt):
    """Linux: while set, a descendant whose parent exits becomes this process's child instead of
    init's, whatever session or group it moved to, where `kill_children` finds it. A no-op elsewhere,
    where the reviewer's process group is all a turn's end reaches."""
    if sys.platform != "linux":
        return
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(PR_SET_CHILD_SUBREAPER, int(adopt), 0, 0, 0) != 0:
        errno = ctypes.get_errno()
        raise OSError(errno, f"prctl(PR_SET_CHILD_SUBREAPER): {os.strerror(errno)}")


def children_of(pid):
    children = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            stat = Path("/proc", entry, "stat").read_bytes()
        except OSError:  # gone meanwhile
            continue
        # The parent is the field after the parenthesized command, which holds any bytes, ")" included.
        if int(stat.rsplit(b")", 1)[1].split()[1]) == pid:
            children.append(int(entry))
    return children


def kill_children():
    """Linux: kills and reaps every child of this process, in passes until none is left; the children
    a killed one leaves are adopted and found by the next pass. A no-op elsewhere."""
    if sys.platform != "linux":
        return
    while children := children_of(os.getpid()):
        for pid in children:
            os.kill(pid, signal.SIGKILL)
        for pid in children:
            os.waitpid(pid, 0)


def stream_events(review, process, leader, prompt, resume_id, timeout, events_path):
    """Feeds the prompt, copies the reviewer's JSONL to the round's file and parses it as it arrives.

    The thread id is persisted the moment the reviewer's event names it: whatever ends the turn
    after that, a timeout, an interrupt or unparsable later output, the thread holds the request
    and a retry resumes it.

    A thread reads the output, and the turn ends with the reviewer's exit, not with the output's
    end, which a process the reviewer left holding its stdout decides; a failure in that thread
    ends the turn too, and is raised here once the cleanup is through. The reviewer's process
    group, which `leader` leads, is killed once the turn ends, or at once on any exception, both
    are reaped, and the orphans the helper adopted are killed and reaped, before this returns or
    the exception propagates, so no process of that group, nor on Linux any descendant of the
    reviewer, outlives the lock that serialized the turn.

    Returns the events, the first thread id or None, the first line that is not JSON or None, and
    whether the timeout killed the reviewer."""
    def feed():
        try:
            process.stdin.write(prompt.encode())
            process.stdin.close()
        except BrokenPipeError:
            pass

    def kill():
        timed_out.append(True)
        signal_group()

    def signal_group():
        try:
            os.killpg(leader.pid, signal.SIGKILL)
        except ProcessLookupError:  # the leader died too: the group has ended
            pass
        signalled.append(True)

    def end_group():
        # Repeatable, since a signal can interrupt it at any point and the handler below runs it
        # again. A timer callback that started before cancel() runs to its end, and must find the
        # leader unreaped. A group signalled once is not signalled again: after the leader is reaped
        # its pid is free for another group, and macOS answers EPERM for a group of zombies.
        if timer is not None:
            timer.cancel()
            timer.join()
        if not signalled:
            signal_group()
        process.wait()
        leader.wait()
        kill_children()  # once the reviewer and the leader are reaped, every child is an adopted orphan
        if reader is not None:
            reader.join()  # at the output's end: on Linux, every process that held the stdout is dead
        if events_stream is not None:
            events_stream.close()

    def watch():
        process.wait()
        turn_over.set()

    def read():
        nonlocal started, bad_line
        try:
            for line in process.stdout:
                events_stream.write(line)
                events_stream.flush()
                stripped = line.strip()
                if not stripped:
                    continue
                try:
                    event = json.loads(stripped)
                except ValueError:
                    if bad_line is None:
                        bad_line = stripped[:200].decode(errors="replace")
                    continue
                if not isinstance(event, dict):
                    continue
                events.append(event)
                if started is None and reviewer.thread_id(event) is not None:
                    started = reviewer.thread_id(event)
                    if resume_id is None:
                        review.state["threadId"] = started
                        review.save()
        except BaseException as ex:  # a thread's exception reaches no one unless carried
            reader_failure.append(ex)
            turn_over.set()

    reviewer = review.reviewer
    timed_out = []
    signalled = []
    turn_over = threading.Event()
    reader_failure = []
    timer = None
    events_stream = None
    reader = None
    events = []
    started = None
    bad_line = None
    try:
        threading.Thread(target=feed, daemon=True).start()
        timer = threading.Timer(timeout, kill)
        timer.start()
        events_stream = open(events_path, "wb")
        reader = threading.Thread(target=read, daemon=True)
        reader.start()
        threading.Thread(target=watch, daemon=True).start()
        turn_over.wait()
        end_group()
        if reader_failure:
            raise reader_failure[0]
    except BaseException as raised:
        # A second signal here would abandon the group again.
        for signum in (*TERMINATING_SIGNALS, signal.SIGINT):
            signal.signal(signum, signal.SIG_IGN)
        end_group()
        if isinstance(raised, KeyboardInterrupt):
            raise ReviewError("TURN_INTERRUPTED", f"interrupted while {reviewer.name} ran")
        raise
    return events, started, bad_line, bool(timed_out)


def run_reviewer(review, round_number, prompt, resume_id, timeout):
    reviewer = review.reviewer
    input_path = review.round_path(round_number, "input.md")
    input_path.write_text(prompt)
    events_path = review.round_path(round_number, reviewer.name + ".jsonl")
    stderr_path = review.round_path(round_number, reviewer.name + ".stderr")
    result_path = review.round_path(round_number, "result.json")
    command = reviewer.command(review.state, resume_id, result_path)
    # For the reviewer's run only, so that the orphans adopted and killed are the reviewer's, not those
    # of the helper's own commands before and after the turn.
    adopt_orphans(True)
    try:
        with open(stderr_path, "wb") as stderr_stream:
            # A process of the helper's own leads the reviewer's group and lives until the group has
            # been killed, so the group's id stays taken until then; a reviewer leading its own group
            # frees it the moment it is reaped, for an unrelated process to take before the kill. The
            # leader reads the helper's pipe, so it exits with the helper at the latest. Joining its
            # group puts the reviewer in the helper's session, with the helper's controlling terminal
            # when it has one.
            leader = subprocess.Popen(["cat"], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, process_group=0)
            # cwd, not an option: `codex exec resume` has no `-C`, and both `codex exec` forms refuse a
            # cwd outside a trusted directory.
            process = subprocess.Popen(
                command, cwd=review.root, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=stderr_stream,
                process_group=leader.pid, env=reviewer.environment(review.state),
            )
            events, started, bad_line, timed_out = stream_events(
                review, process, leader, prompt, resume_id, timeout, events_path,
            )
    finally:
        adopt_orphans(False)
    stderr = stderr_path.read_bytes().decode(errors="replace")
    if timed_out:
        raise ReviewerError(
            reviewer, "TURN_INTERRUPTED", f"{reviewer.name} exceeded {timeout} seconds and was killed",
        )
    if process.returncode != 0 or any(reviewer.failed(event) for event in events):
        raise classify_failure(reviewer, process.returncode, stderr, events)
    if bad_line is not None:
        raise ReviewerError(
            reviewer, "INVALID_RESULT", f"{reviewer.name} printed a line that is not JSON", line=bad_line,
        )
    if started is None:
        raise reviewer_failed(
            reviewer, f"{reviewer.name} ended without a {reviewer.thread_event} event", stderr, events,
            stderr=stderr[-2000:],
        )
    if resume_id is not None and started != resume_id:
        raise ReviewerError(
            reviewer, "REVIEWER_RESUME_MISMATCH", f"{reviewer.name} resumed a different thread than this review's",
            expected=resume_id, actual=started,
        )
    text = reviewer.final_result(events, result_path)
    if text is None:
        raise ReviewerError(reviewer, "INVALID_RESULT", f"{reviewer.name} wrote no final message")
    try:
        result = json.loads(text)
    except ValueError as ex:
        raise ReviewerError(reviewer, "INVALID_RESULT", f"{reviewer.name}'s final message is not JSON: {ex}")
    problem = validate_result(result)
    if problem is not None:
        raise ReviewerError(
            reviewer, "INVALID_RESULT", f"{reviewer.name}'s final message does not follow the schema: " + problem,
            result=result,
        )
    return result


def review_turn(review, message):
    """One reviewer turn under the review's lock: the state machine's REVIEWING edge and its exits.

    Until a round has completed, the turn is the review request, on the thread an earlier failed
    attempt opened if there is one."""
    state = review.state
    first = state["lastReviewed"] is None
    if state["status"] in TERMINAL:
        raise ReviewError("REVIEW_CLOSED", f"review {review.id} is {state['status']}; start a new review")
    entries = review.journal_entries()
    answered = [entry["round"] for entry in entries if entry["actor"] == "reviewer"]
    # Failed rounds do not count, so retries after a usage limit do not use up the review.
    if len(answered) >= state["maxRounds"]:
        state["status"] = "LOOP_LIMIT_REACHED"
        review.save()
        raise ReviewError("LOOP_LIMIT_REACHED", f"review {review.id} reached {state['maxRounds']} answered rounds")
    check_signed_in(review.reviewer)
    check_egress(review.reviewer)
    round_number = state["round"] + 1
    before = observe(review.root)
    prompt_file = "reviewer.md" if first else "continue.md"
    heading = "# Review request from the author" if first else f"# The author's response, round {round_number}"
    prompt = (PLUGIN_ROOT / "prompts" / prompt_file).read_text()
    if state.get("instructions"):
        # Every round, so that they stay in force however long the thread grows.
        prompt += (
            "\n---\n\n# Instructions from the user\n\nThese take precedence over the reviewer instructions"
            " above.\n\n" + state["instructions"].rstrip("\n") + "\n"
        )
    base = state.get("base")
    scope = (
        f"Review the changes since `{base['ref']}`, commit {base['commit']}: `git diff {base['commit']}` shows"
        " them, committed since then or not, plus untracked files."
        if base else
        "Review the working tree's changes against HEAD: `git diff HEAD` plus untracked files."
    )
    prompt += "\n---\n\n# Scope\n\n" + scope + "\n"
    # A failed turn may or may not have left the author's message in the reviewer's thread, and the author
    # writes the next message as a sequel, so the next turn sends the unanswered ones again.
    unanswered = [
        entry for entry in entries
        if entry["actor"] == "author" and entry["kind"] in ("review-request", "review-response")
        and entry["round"] > max(answered, default=0)
    ]
    for entry in unanswered:  # as written, like the latest message: the reviewer reads code in them
        prompt += (
            f"\n---\n\n# The author's message of round {entry['round']}, which you did not answer\n\n"
            "Your turn on it ended in an error before you answered. The author's latest message follows the"
            " unanswered ones.\n\n" + entry["text"].rstrip("\n") + "\n"
        )
    prompt += "\n---\n\n" + heading + "\n\n" + message.rstrip("\n") + "\n"
    previous_status = state["status"]
    state["status"] = "REVIEWING"
    state["round"] = round_number
    state["lastError"] = None
    state["turnStartedAt"] = now()
    review.save()
    try:
        write_json_atomically(review.round_path(round_number, "manifest.json"), before["manifest"])
        taken = snapshot(review, round_number, before)
        state.setdefault("snapshots", []).append(taken)
        review.journal({
            "round": round_number, "actor": "author", "kind": "review-request" if first else "review-response",
            "text": message, "head": before["head"], "worktreeDigest": before["digest"], "snapshot": taken,
        })
        result = run_reviewer(review, round_number, prompt, state["threadId"], state["timeoutSeconds"])
        after = observe(review.root)  # a second observation: what the reviewer read must be what is still there
        if after["digest"] != before["digest"]:
            raise ReviewError(
                "WORKTREE_CHANGED_DURING_REVIEW",
                f"the working tree changed while {review.reviewer.name} reviewed it; the result is discarded,"
                " review again",
                before=before["digest"], after=after["digest"],
                paths=manifest_changes(before["manifest"], after["manifest"]),
            )
    except BaseException as raised:
        ex = raised if isinstance(raised, ReviewError) else ReviewError("HELPER_FAILED", repr(raised))
        state["status"] = previous_status
        state["lastError"] = {"round": round_number, "at": now(), **ex.to_json()}
        review.save()
        review.journal({"round": round_number, "actor": "helper", "kind": "error", **ex.to_json()})
        if state.get("snapshots") and state["snapshots"][-1]["round"] == round_number:
            state["snapshots"][-1]["tag"] = attach_transcript(
                review, state["snapshots"][-1], review.round_transcript(round_number),
            )
            review.save()
        raise ex
    state["status"] = {"USER_DECISION_REQUIRED": "USER_PROPOSED"}.get(result["disposition"], result["disposition"])
    reviewed = {
        "head": before["head"], "worktreeDigest": before["digest"], "contentDigest": before["contentDigest"],
        "round": round_number, "ref": taken["ref"], "tree": taken["tree"], "excludes": taken["excludes"],
    }
    state["lastReviewed"] = reviewed
    state["approvalCleared"] = None
    if result["disposition"] == "APPROVED":
        state["approved"] = {**reviewed, "at": now()}
    else:
        state["approved"] = None
    review.save()
    review.journal({
        "round": round_number, "actor": "reviewer", "kind": "review-result", "disposition": result["disposition"],
        "result": result,
    })
    taken["tag"] = attach_transcript(review, taken, review.round_transcript(round_number))
    review.save()
    return {
        **review.summary(after),
        "disposition": result["disposition"],
        "summary": result["summary"],
        "findings": result["findings"],
        "userDecision": result["userDecision"],
    }


def check_scope(root, base):
    """Refuse a review of nothing: a reviewer turn on an empty scope yields an approval that looks like
    one of the session's committed work, which only `--base` brings into scope.

    The scope is what the reviewer is told to look at, the working tree against the base commit, HEAD
    without `--base`, plus untracked files; a dirty checkout whose edits restore the base's
    content is empty too. External diff drivers and submodule settings could hide a change, so
    the comparison runs without them."""
    if any(record[:1] == b"?" for path, record in status_records(root)):
        return
    if base is None and git(root, "rev-parse", "--verify", "--quiet", "HEAD", check=False).returncode != 0:
        # Unborn HEAD: the whole working tree is the scope. The index lists a staged file after its
        # deletion from disk, so what counts is a listed file that is still there.
        listed = git(root, "ls-files", "-z").stdout.split(b"\0")
        if any(path and worktree_entry(root, path) != b"missing" for path in listed):
            return
        raise ReviewError("NOTHING_TO_REVIEW", "the repository has no files, so nothing is in the review's scope")
    against = base["commit"] if base else "HEAD"
    compared = git(
        root, "diff", "--quiet", "--no-ext-diff", "--no-textconv", "--ignore-submodules=none", against, check=False,
    )
    if compared.returncode == 1:
        return
    if compared.returncode != 0:
        raise GitFailure(f"git diff --quiet {against} failed", stderr=compared.stderr.decode(errors="replace")[-500:])
    raise ReviewError(
        "NOTHING_TO_REVIEW",
        f"the working tree equals {base['ref'] if base else 'HEAD'}, so nothing is in the review's scope"
        + ("" if base else "; to review commits made since a branch or commit, pass `--base REF`"),
    )


def read_message(path):
    try:
        message = Path(path).read_text()
    except OSError as ex:
        raise ReviewError("MESSAGE_UNREADABLE", f"cannot read {path}: {ex}")
    if not message.strip():
        raise ReviewError("MESSAGE_UNREADABLE", f"{path} is empty")
    return message


def command_start(args):
    root = repository_root(args.repository)
    message = read_message(args.message_file)
    instructions = read_message(args.instructions_file) if args.instructions_file else None
    base = resolve_base(root, args.base) if args.base else None
    check_scope(root, base)
    REVIEWERS[args.reviewer].check_choice({"model": args.model, "effort": args.effort})
    review = Review.create(root, args.max_rounds, REVIEWERS[args.reviewer])
    review.state["timeoutSeconds"] = args.timeout
    review.state["instructions"] = instructions
    review.state["base"] = base
    review.state["model"] = args.model
    review.state["effort"] = args.effort
    review.save()
    review.lock()
    if instructions is not None:
        review.journal({"round": 1, "actor": "user", "kind": "instructions", "text": instructions})
    return review_turn(review, message)


def command_continue(args):
    root = repository_root(args.repository)
    message = read_message(args.message_file)
    instructions = read_message(args.instructions_file) if args.instructions_file else None
    review = Review.open(root, args.review_id)
    if instructions is not None:
        # The reviewer never approved the tree under these instructions.
        review.state["instructions"] = instructions
        if review.state.get("approved"):
            review.state["approvalCleared"] = {
                "reason": "the review instructions changed after the approval", "round": review.state["round"] + 1,
                "at": now(),
            }
        review.state["approved"] = None
        review.save()
        review.journal({
            "round": review.state["round"] + 1, "actor": "user", "kind": "instructions", "text": instructions,
        })
    return review_turn(review, message)


def command_escalate(args):
    root = repository_root(args.repository)
    message = read_message(args.message_file)
    review = Review.open(root, args.review_id)
    if review.state["status"] != "USER_PROPOSED":
        raise ReviewError(
            "ESCALATION_NOT_PROPOSED",
            f"review {review.id} is {review.state['status']}: escalate only after {review.reviewer.name} asked for"
            " the user's decision",
        )
    review.state["status"] = "USER_DECISION_REQUIRED"
    review.save()
    review.journal({"round": review.state["round"], "actor": "author", "kind": "escalation", "text": message})
    return review.summary()


def command_verify(args):
    root = repository_root(args.repository)
    review = Review(root, args.review_id).load()
    summary = review.summary()
    if summary["effectiveStatus"] != "APPROVED":
        raise ReviewError(
            "NOT_APPROVED", f"review {review.id} is {summary['effectiveStatus']}, not an approval of the current tree",
            **summary,
        )
    return summary


def command_show(args):
    root = repository_root(args.repository)
    return Review(root, args.review_id).load().summary()


LIST_FIELDS = ("reviewId", "reviewer", "effectiveStatus", "round", "approvalFresh", "createdAt", "updatedAt")


def command_list(args):
    root = repository_root(args.repository)
    reviews_dir = repository_dir(root) / "reviews"
    rows = []
    if reviews_dir.exists():
        observation = observe(root)  # one scan for every review's freshness
        for entry in reviews_dir.iterdir():
            if (entry / "state.json").exists():
                try:
                    summary = Review(root, entry.name).load().summary(observation)
                except ReviewError as ex:
                    # A review this helper cannot read is still listed, by what every version's
                    # state holds, so that its id can be given to `delete`.
                    state = Review(root, entry.name).load(check_readable=False).state
                    summary = {
                        "reviewId": entry.name, "reviewer": state.get("reviewer"), "effectiveStatus": ex.code,
                        "round": state.get("round"), "approvalFresh": False, "createdAt": state.get("createdAt"),
                        "updatedAt": state.get("updatedAt"),
                    }
                rows.append({key: summary[key] for key in LIST_FIELDS})
    rows.sort(key=lambda row: row["createdAt"] or "")
    return {"repository": str(root), "reviews": rows}


# A fence run after any list and block quote markers, which group 1 holds, and any indentation.
FENCE_OPENING = re.compile(r"((?:[ \t]*(?:[-+*]|\d{1,9}[.)])[ \t]+|[ \t]*>[ \t]?)*)[ \t]*(`{3,}|~{3,})")
LIST_MARKER = re.compile(r"[-+*]|\d{1,9}[.)]")
ATX_HEADING = re.compile(r"( {0,3})(#{1,6})(?=[ \t]|$)")


def shifted(markdown):
    """The message's ATX headings two levels down, at most to level 6, under the `###` heading that
    names who wrote it, for the export and the transcript on a round's ref.

    Where a line may be code, it stays as written, so a misreading can leave a heading unshifted
    but never change code: any line that could open a fence opens one, and only a line that
    certainly closes it does. That line repeats the opening line's containers, its list markers
    as spaces, then has at most three spaces, a run of the fence's character at least as long, and
    nothing else."""
    lines = []
    fence = None  # (containers a closing line repeats, character, length) of the open fence
    for line in markdown.rstrip("\n").splitlines():
        if fence is None:
            opening = FENCE_OPENING.match(line)
            if opening:
                containers = LIST_MARKER.sub(lambda marker: " " * len(marker.group()), opening.group(1))
                fence = (containers, opening.group(2)[0], len(opening.group(2)))
                lines.append(line)
                continue
        else:
            containers, character, length = fence
            closing = re.fullmatch(
                " {0,3}(" + re.escape(character) + "{" + str(length) + ",})[ \t]*", line[len(containers):],
            )
            if line.startswith(containers) and closing:
                fence = None
            lines.append(line)
            continue
        heading = ATX_HEADING.match(line)
        if heading:
            level = min(len(heading.group(2)) + 2, 6)
            line = heading.group(1) + "#" * level + line[heading.end():]
        lines.append(line)
    return "\n".join(lines)


def render_entries(reviewer, entries, with_round_headings=True):
    """The journal entries as Markdown: the export's body, and a round's transcript on its ref."""
    lines = []
    current_round = None
    for entry in entries:
        if with_round_headings and entry.get("round") != current_round:
            current_round = entry.get("round")
            lines += [f"## Round {current_round}", ""]
        taken = entry.get("snapshot")
        if taken and taken.get("ref"):
            lines.append(f"Snapshot: `{taken['ref']}` (tree {taken['tree']})")
            if taken.get("excludes"):
                lines.append("The snapshot holds only the commit ids of: " + ", ".join(taken["excludes"]))
            lines.append("")
        if entry["actor"] == "user":
            lines += ["### Instructions from the user, from this round on", "", shifted(entry["text"]), ""]
        elif entry["actor"] == "author" and entry["kind"] in ("review-request", "review-response"):
            lines += ["### The author", "", shifted(entry["text"]), ""]
        elif entry["actor"] == "author":
            lines += ["### The author agreed that the user must decide", "", shifted(entry["text"]), ""]
        elif entry["actor"] == "reviewer":
            result = entry["result"]
            lines += [f"### {reviewer.display}: {result['disposition']}", "", result["summary"], ""]
            for finding in result["findings"]:
                where = f" `{finding['location']}`" if finding.get("location") else ""
                lines.append(f"- **{finding['id']}** ({finding['severity']}){where}: {finding['description']}")
                lines.append(f"  Evidence: {finding['evidence']}")
            if result["findings"]:
                lines.append("")
            if result.get("userDecision"):
                decision = result["userDecision"]
                lines += [
                    f"- Issue: {decision['issue']}",
                    f"- {reviewer.display}'s position: {decision['reviewerPosition']}",
                    f"- Why evidence cannot decide: {decision['whyTechnicalEvidenceCannotDecide']}",
                    f"- Decision requested: {decision['decisionRequested']}", "",
                ]
        else:
            lines += [f"### Error: {entry.get('code')}", "", entry.get("message", ""), ""]
    return lines


def command_export(args):
    root = repository_root(args.repository)
    review = Review(root, args.review_id).load()
    if args.round is not None:
        if not any(entry.get("round") == args.round for entry in review.journal_entries()):
            raise ReviewError("UNKNOWN_ROUND", f"review {review.id} has no round {args.round}")
        sys.stdout.write(review.round_transcript(args.round) + "\n")
        return None
    state = review.state
    lines = [f"# {review.reviewer.display} review {review.id}", ""]
    lines += [f"- Repository: {state['repository']}", f"- Status: {review.freshness()[2]}"]
    if state.get("base"):
        lines.append(f"- Base: {state['base']['ref']} ({state['base']['commit']})")
    lines += [f"- {review.reviewer.display} thread: {state['threadId']}", f"- Started: {state['createdAt']}", ""]
    lines += render_entries(review.reviewer, review.journal_entries())
    lines += ["## How to see how it went", "", "```sh", *review.inspect_lines(), "```", ""]
    sys.stdout.write("\n".join(lines))
    return None


def command_diff(args):
    """The working tree against a round's snapshot, untracked files included: `git diff <tree>`
    alone reads the user's index and reports an untracked file as deleted."""
    root = repository_root(args.repository)
    review = Review(root, args.review_id).load()
    snapshots = [entry for entry in review.state.get("snapshots", []) if entry.get("ref")]
    if args.round is not None:
        chosen = [entry for entry in snapshots if entry["round"] == args.round]
    elif review.state.get("approved") and review.state["approved"].get("ref"):
        chosen = [review.state["approved"]]
    else:
        chosen = snapshots[-1:]
    if not chosen:
        raise ReviewError("NO_SNAPSHOT", f"review {review.id} has no snapshot for that round")
    descriptor, scratch = tempfile.mkstemp(dir=review.dir, prefix="diff-index.")  # one per invocation
    os.close(descriptor)
    current = tree_of_worktree(root, Path(scratch))
    sys.stdout.flush()
    completed = subprocess.run(["git", "diff", *args.git_args, chosen[0]["tree"], current], cwd=root, check=False)
    if completed.returncode != 0:
        raise ReviewError("GIT_FAILED", "git diff failed")
    return None


def command_delete(args):
    root = repository_root(args.repository)
    review = Review.open(root, args.review_id, check_readable=False)
    refs = snapshot_refs(review)
    for ref in refs:
        git(root, "update-ref", "-d", ref)
    shutil.rmtree(review.dir)
    return {"reviewId": review.id, "removedRefs": refs, "removedDirectory": str(review.dir)}


GIT_METADATA_LIMIT = 64 * 1024  # Codex's MAX_GIT_METADATA_FILE_BYTES


def git_metadata(path):
    """The stripped content of a Git metadata file as Codex reads one: a regular file, not a symlink, of at
    most GIT_METADATA_LIMIT bytes; None otherwise."""
    try:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_size > GIT_METADATA_LIMIT:
            return None
        return path.read_bytes().strip()
    except OSError:
        return None


def gitdir_pointer(dot_git):
    """The directory a `.git` file's `gitdir:` line names, as Codex reads it; None otherwise."""
    content = git_metadata(dot_git)
    if content is None or not content.startswith(b"gitdir:"):
        return None
    target = content.removeprefix(b"gitdir:").strip()
    return dot_git.parent / os.fsdecode(target) if target else None


def main_checkout(root):
    """The main checkout of the linked worktree `root`, whose trust entry Codex applies to the worktree when
    the worktree has none of its own; None otherwise. The checks are Codex's own, in
    `resolve_root_git_project_for_trust` (codex-rs/git-utils/src/trust.rs): Git follows symlinks and
    registrations Codex refuses, and a trust Git's view granted here would offer project settings Codex
    skips."""
    git_dir = gitdir_pointer(root / ".git")
    if git_dir is None or git_dir.is_symlink() or not git_dir.is_dir():
        return None
    canonical_git_dir = git_dir.resolve()
    if canonical_git_dir.parent.name != "worktrees":
        return None
    common_dir = canonical_git_dir.parent.parent
    registered = git_metadata(canonical_git_dir / "gitdir")
    linked_common_dir = git_metadata(canonical_git_dir / "commondir")
    if not registered or not linked_common_dir:
        return None
    registered = canonical_git_dir / os.fsdecode(registered)
    if registered.name != ".git" or registered.parent.resolve() != root.resolve():
        return None
    if (canonical_git_dir / os.fsdecode(linked_common_dir)).resolve() != common_dir:
        return None
    main = git_dir.parent.parent.parent
    main_git_dir = main / ".git" if (main / ".git").is_dir() else gitdir_pointer(main / ".git")
    return main if main_git_dir is not None and main_git_dir.resolve() == common_dir else None


def codex_config_layers(root):
    """The local configuration files Codex reads for this repository, highest precedence first:
    the project's `.codex/config.toml` when the user configuration trusts the project or its main checkout,
    the user configuration, the image's system layer. Codex's cloud-managed layer is not on disk."""
    user = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "config.toml"
    layers = [user, Path("/etc/codex/config.toml")]
    project = root / ".codex/config.toml"
    if project.is_file() and user.is_file():
        try:
            projects = tomllib.loads(user.read_text()).get("projects", {})
        except tomllib.TOMLDecodeError:
            projects = {}
        main = main_checkout(root)
        # Codex looks a checkout up by its canonical path, then by the path as found
        keys = [str(root)] + ([str(main.resolve()), str(main)] if main else [])
        trust = next((
            projects[key]["trust_level"] for key in keys
            if isinstance(projects.get(key), dict) and "trust_level" in projects[key]
        ), None)
        if trust == "trusted":
            layers.insert(0, project)
    return layers


def codex_catalog():
    """Codex's model catalog sorted by `priority`, as Codex sorts the list its `/model` picker shows and takes its
    default model from, with each model's efforts lowest first; None when Codex cannot render it. `hidden`
    marks the models the picker leaves out."""
    try:
        rendered = subprocess.run(["codex", "debug", "models"], capture_output=True, text=True, check=True, timeout=60)
        models = json.loads(rendered.stdout)["models"]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        return None
    return [
        {
            "model": model.get("slug"),
            "description": model.get("description"),
            "defaultEffort": model.get("default_reasoning_level"),
            "efforts": [level.get("effort") for level in model.get("supported_reasoning_levels", [])],
            "hidden": model.get("visibility") != "list",
            "upgrade": model.get("upgrade") if isinstance(model.get("upgrade"), dict) else None,
        }
        for model in sorted(
            (model for model in models if isinstance(model, dict) and model.get("slug")),
            key=lambda model: model["priority"] if isinstance(model.get("priority"), int) else math.inf,
        )
    ]


def codex_defaults(root):
    """The model and reasoning effort Codex's local configuration selects for this repository, for the
    skill to offer first. `partial` says that a cloud-managed layer, which Codex ranks above the
    user's file, could still name others; an explicit `--model` or `--effort` removes the doubt.
    `recommended` is the pair Codex would use: the configured model, else Codex's default, the first model
    its picker lists, and the configured effort, else the catalog's default for that model. A value the
    catalog cannot fill stays null: Codex's built-in default, which the skill leaves to Codex by passing no
    option. `catalog` lists the models Codex's `/model` picker offers; a configured hidden model still gets
    its efforts in `recommended`, and a retiring one the model Codex recommends upgrading to."""
    found = {"model": None, "effort": None, "source": {"model": None, "effort": None}, "partial": True}
    for layer in codex_config_layers(root):
        if not layer.is_file():
            continue
        try:
            config = tomllib.loads(layer.read_text())
        except (tomllib.TOMLDecodeError, OSError) as ex:
            raise ReviewerError(REVIEWERS["codex"], "REVIEWER_CONFIG_UNREADABLE", f"{layer}: {ex}")
        for key, name in (("model", "model"), ("model_reasoning_effort", "effort")):
            if found[name] is None and isinstance(config.get(key), str):
                found[name] = config[key]
                found["source"][name] = str(layer)
    catalog = codex_catalog()
    listed = None if catalog is None else [model for model in catalog if not model["hidden"]]
    recommended_model = found["model"] or (listed[0]["model"] if listed else None)
    entry = next((model for model in catalog or [] if model["model"] == recommended_model), None)
    found["catalog"] = None if listed is None else [
        {key: value for key, value in model.items() if key not in ("hidden", "upgrade")} for model in listed
    ]
    upgrade = entry["upgrade"] if entry else None
    found["recommended"] = {
        "model": recommended_model,
        "effort": found["effort"] or (entry["defaultEffort"] if entry else None),
        "efforts": entry["efforts"] if entry else None,
        "upgrade": {
            "model": upgrade.get("model"), "migrationMarkdown": upgrade.get("migration_markdown"),
        } if upgrade else None,
    }
    return found


# The aliases Claude Code documents, with its wording, and the efforts its table gives the models
# they name on the Anthropic API (code.claude.com/docs/en/model-config). Haiku takes no effort.
CLAUDE_EFFORTS = ["low", "medium", "high", "xhigh", "max"]
CLAUDE_MODELS = (
    ("fable", "the Fable model for your provider, for the hardest and longest-running tasks", CLAUDE_EFFORTS),
    ("opus", "the latest Opus model, for complex reasoning tasks", CLAUDE_EFFORTS),
    ("sonnet", "the latest Sonnet model, for daily coding tasks", CLAUDE_EFFORTS),
    ("haiku", "the fast and efficient Haiku model, for simple tasks", []),
)


def claude_managed_directory():
    """Where Claude Code reads file-based managed settings (code.claude.com/docs/en/managed-settings);
    `KO_REVIEW_CLAUDE_MANAGED_SETTINGS` names another directory, for the tests."""
    override = os.environ.get("KO_REVIEW_CLAUDE_MANAGED_SETTINGS")
    if override:
        return Path(override)
    if sys.platform == "darwin":
        return Path("/Library/Application Support/ClaudeCode")
    return Path("/etc/claude-code")


def claude_managed_settings():
    """The managed settings files as (path, settings), the one Claude Code merges last first:
    `managed-settings.d/*.json` in reverse alphabetical order, hidden files left out, then
    `managed-settings.json`."""
    directory = claude_managed_directory()
    drop_ins = directory / "managed-settings.d"
    files = sorted(
        (path for path in drop_ins.glob("*.json") if not path.name.startswith(".")), reverse=True,
    ) if drop_ins.is_dir() else []
    layers = []
    for path in [*files, directory / "managed-settings.json"]:
        if not path.is_file():
            continue
        try:
            settings = json.loads(path.read_text())
        except (ValueError, OSError) as ex:
            raise ReviewerError(REVIEWERS["claude"], "REVIEWER_CONFIG_UNREADABLE", f"{path}: {ex}")
        if isinstance(settings, dict):
            layers.append((path, settings))
    return layers


def claude_managed_variable(name):
    """The value the highest-ranking managed `env` block naming the variable gives it and the file
    that does, else (None, None). Claude Code writes such a value over the one its process
    inherited, an empty one included, which leaves the variable unset for it: the value is then ""."""
    for path, settings in claude_managed_settings():
        block = settings.get("env")
        if isinstance(block, dict) and isinstance(block.get(name), str):
            return block[name], str(path)
    return None, None


def claude_defaults(root):
    """The model and effort the reviewer's session would use, for the skill to offer first. That
    session loads no user, project or local settings file (`--setting-sources ""`), so what selects
    them is the environment and the managed settings: `ANTHROPIC_MODEL`, else the managed `model`,
    else `ANTHROPIC_DEFAULT_MODEL`; `CLAUDE_CODE_EFFORT_LEVEL`, else the managed top-level
    `effortLevel`. A managed `env` block overrides the inherited variable. A value nothing sets stays
    null: Claude Code's own default, which the skill leaves to it by passing no option.

    Managed `modelSettings`, which set an effort per model under Claude Code's canonical model names,
    are not resolved: where a managed file holds them the effort stays null. `partial` is true
    because server-managed settings and a role's effort cap are not on disk. The catalog's efforts
    are those of the models the aliases name on the Anthropic API; for any other model `efforts` is
    null, and Claude Code lowers a level the model does not support."""
    found = {"model": None, "effort": None, "source": {"model": None, "effort": None}, "partial": True}

    def variable(name):
        value, source = claude_managed_variable(name)
        if value is not None:  # the managed entry decides, and an empty one unsets the variable
            return (value, source + " env") if value else (None, None)
        return (os.environ[name], name) if os.environ.get(name) else (None, None)

    managed = claude_managed_settings()
    model_sources = [variable("ANTHROPIC_MODEL")]
    model_sources += [
        (settings["model"], str(path)) for path, settings in managed if isinstance(settings.get("model"), str)
    ]
    model_sources.append(variable("ANTHROPIC_DEFAULT_MODEL"))
    found["model"], found["source"]["model"] = next((pair for pair in model_sources if pair[0]), (None, None))
    found["effort"], found["source"]["effort"] = variable("CLAUDE_CODE_EFFORT_LEVEL")
    if found["effort"] is None and not any("modelSettings" in settings for path, settings in managed):
        found["effort"], found["source"]["effort"] = next(
            ((settings["effortLevel"], str(path)) for path, settings in managed
             if isinstance(settings.get("effortLevel"), str)), (None, None),
        )
    found["catalog"] = [
        {"model": model, "description": description, "defaultEffort": None, "efforts": efforts}
        for model, description, efforts in CLAUDE_MODELS
    ]
    entry = next((model for model in found["catalog"] if model["model"] == found["model"]), None)
    found["recommended"] = {
        "model": found["model"], "effort": found["effort"], "efforts": entry["efforts"] if entry else None,
        "upgrade": None,
    }
    return found


def command_defaults(args):
    return REVIEWERS[args.reviewer].defaults(repository_root(args.repository))


def command_digest(args):
    root = repository_root(args.repository)
    observation = observe(root)
    return {
        "repository": str(root), "head": observation["head"], "worktreeDigest": observation["digest"],
        "contentDigest": observation["contentDigest"], "files": len(observation["manifest"]),
    }


def build_parser():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--repository", default=os.getcwd(), help="a directory inside the working tree (default: cwd)")
    commands = parser.add_subparsers(dest="command", required=True)

    def add(name, handler, help_text, review_id=False, message=False, reviewer=False):
        sub = commands.add_parser(name, help=help_text)
        if reviewer:
            # `start codex`, `start claude`: the review records its reviewer, and every later command
            # reads it from there.
            sub.add_argument("reviewer", choices=sorted(REVIEWERS))
        if review_id:
            sub.add_argument("review_id")
        if message:
            sub.add_argument("--message-file", required=True)
        sub.set_defaults(handler=handler)
        return sub

    start = add("start", command_start, "review the working tree on a new reviewer thread", message=True, reviewer=True)
    start.add_argument(
        "--max-rounds", type=int, default=DEFAULT_MAX_ROUNDS, help="rounds the reviewer answers before the review ends",
    )
    start.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT_SECONDS, help="seconds per reviewer turn")
    start.add_argument(
        "--instructions-file", help="the user's instructions to the reviewer, added to every round of this review",
    )
    start.add_argument("--base", help="review the changes since this commit or branch, not only the uncommitted ones")
    start.add_argument("--model", help="the reviewer's model for every round (default: its configured model)")
    start.add_argument("--effort", help="the reviewer's reasoning effort for every round (default: its configured one)")
    export = add("export", command_export, "print the review's transcript as Markdown", review_id=True)
    export.add_argument("--round", type=int, help="print only this round: the author's message and the reviewer's")
    diff = add("diff", command_diff, "git diff of a round's snapshot against the working tree", review_id=True)
    diff.add_argument("--round", type=int, help="the round to compare with (default: the approved one, else the last)")
    diff.add_argument("git_args", nargs="*", help="options for git diff after `--`, such as `-- --stat`")
    add(
        "delete", command_delete,
        "delete the review's state and its refs; the objects become eligible for a later git gc", review_id=True,
    )
    add(
        "continue", command_continue, "send the author's response to the review's reviewer thread",
        review_id=True, message=True,
    ).add_argument("--instructions-file", help="replaces the user's standing instructions from this round on")
    add(
        "escalate", command_escalate, "record the author's agreement that the user must decide",
        review_id=True, message=True,
    )
    add("verify", command_verify, "succeed only if the approval covers the current working tree", review_id=True)
    add("show", command_show, "print the review's state", review_id=True)
    add("list", command_list, "list this checkout's reviews, one short entry each; `show` prints one in full")
    add(
        "defaults", command_defaults,
        "print the model and reasoning effort the reviewer would use, and the models it offers", reviewer=True,
    )
    add("digest", command_digest, "print the working-tree digest")
    return parser


def raise_terminated(signum, frame):
    raise ReviewError("TURN_INTERRUPTED", f"terminated by {signal.Signals(signum).name}")


def main(argv):
    args = build_parser().parse_args(argv)
    for signum in TERMINATING_SIGNALS:
        signal.signal(signum, raise_terminated)
    try:
        output = args.handler(args)
        status = 0
    except ReviewError as ex:
        output = {"error": ex.to_json()}
        if CURRENT_REVIEW is not None and CURRENT_REVIEW.state is not None and CURRENT_REVIEW.state_path.exists():
            output.update({
                "reviewId": CURRENT_REVIEW.id, "status": CURRENT_REVIEW.state.get("status"),
                "statePath": str(CURRENT_REVIEW.state_path), "inspect": CURRENT_REVIEW.inspect_lines(),
                "snapshots": CURRENT_REVIEW.state.get("snapshots", []),  # a transcriptError travels here
            })
        status = 1
    if output is not None:  # export wrote its Markdown itself
        json.dump(output, sys.stdout, indent=2)
        sys.stdout.write("\n")
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
