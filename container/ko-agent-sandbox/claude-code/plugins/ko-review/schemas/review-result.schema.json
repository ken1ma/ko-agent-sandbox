{
  "type": "object",
  "additionalProperties": false,
  "required": ["disposition", "summary", "findings", "suggestions", "userDecision"],
  "properties": {
    "disposition": {
      "type": "string",
      "enum": ["APPROVED", "CHANGES_REQUESTED", "USER_DECISION_REQUIRED"]
    },
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "location", "description", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "location": {"type": ["string", "null"]},
          "description": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "location", "description", "reason"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["design", "simplification", "alternative", "question"]},
          "location": {"type": ["string", "null"]},
          "description": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "userDecision": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["issue", "reviewerPosition", "whyTechnicalEvidenceCannotDecide", "decisionRequested"],
          "properties": {
            "issue": {"type": "string"},
            "reviewerPosition": {"type": "string"},
            "whyTechnicalEvidenceCannotDecide": {"type": "string"},
            "decisionRequested": {"type": "string"}
          }
        }
      ]
    }
  }
}
