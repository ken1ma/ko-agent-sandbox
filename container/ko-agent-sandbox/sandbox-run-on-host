#!/bin/sh
#
# Requests the host to run a command, inside a sandbox of its own.
# This can be used only when the session was launched with --run-on-host listing this command.
#
# One transaction, serialized by the lock: hand the broker this pid, then send the request over
# `ctl.$$` and hold it open — the request travels on the liveness descriptor, so the broker ends
# the command the moment this process dies, Ctrl-C included, and no request is ever runnable
# without its liveness. The data FIFOs are this transaction's own, so no later invocation can
# attach to another's streams. RunOnHostChannel.scala is the other side and documents the framing.
set -eu

usage() { echo "usage: sandbox-run-on-host <sbt|mill|gradle|mvn> [args...]" >&2; exit 64; }
[ "$#" -ge 1 ] || usage
program=$1
shift
case "$program" in sbt|mill|gradle|mvn) ;; *) usage ;; esac

# The launcher's broker creates "$dir/req".
dir=/tmp/ko-agent-sandbox/run-on-host
# Seconds for startup through opening both streams, and separately for the exit-status read.
bound=30
if [ -n "${KO_AGENT_SANDBOX_RUN_ON_HOST:-}" ]; then
  i=0
  while [ ! -p "$dir/req" ] && [ "$i" -lt 100 ]; do i=$((i + 1)); sleep 0.1; done
fi
[ -p "$dir/req" ] || {
  echo "sandbox-run-on-host: this session was not launched with --run-on-host=$program," \
    "or the broker has died unexpectedly" >&2
  exit 1
}

# One command at a time; a later invocation waits here until the running one completes.
exec 9> "$dir/lock"
flock 9

# Create fresh FIFOs so a reused pid cannot adopt a killed predecessor's transaction.
# SIGKILL bypasses cleanup: the watchdog can survive until its deadline and signal a reused pid.
pid=$$
fifos="$dir/ctl.$pid $dir/out.$pid $dir/err.$pid $dir/exit.$pid"
unanswered="$dir/unanswered.$pid"
watchdog=
stop_watchdog() {
  if [ -n "$watchdog" ]; then
    kill "$watchdog" 2>/dev/null || true
    wait "$watchdog" 2>/dev/null || true
    watchdog=
  fi
}
finish() {
  status=${1:-$?}
  trap - EXIT
  trap '' HUP INT TERM PIPE
  # Stop before removing the marker: a timer still running could recreate it after cleanup.
  stop_watchdog
  rm -f $fifos
  if [ -e "$unanswered" ]; then
    rm -f "$unanswered"
    echo "sandbox-run-on-host: the host side did not answer within ${bound}s — report this to the user" >&2
    exit 70
  fi
  exit "$status"
}
trap finish EXIT
rm -f $fifos "$unanswered"
mkfifo -m 600 $fifos

# The startup watchdog bounds writing the handshake and request and opening both output streams.
# A dead broker can leave any of these blocked. The watchdog ends this shell after leaving the
# marker finish() reports on, and is disarmed once both streams are open, which the broker does
# when it starts the command (RunOnHostChannel.dispatch). It holds no lock, and its output goes
# nowhere: the sleep it leaves behind must keep neither the next command nor the agent's pipes
# waiting.
( sleep "$bound"; : > "$unanswered"; kill -TERM "$pid" ) >/dev/null 2>&1 9>&- &
watchdog=$!
# bash retries an open a handled signal interrupted, so the handler must exit. dash fails the
# open and exits under set -e, running the handler on its way out — but not the EXIT trap after
# a handler that exits, so each signal calls finish() directly.
trap 'finish 129' HUP
trap 'finish 130' INT
trap 'finish 143' TERM
trap 'finish 141' PIPE

exec 7> "$dir/req"
printf '%s\n' "$pid" >&7
exec 7>&-

# The broker opens ctl's reading side once it has the handshake; dying before this open leaves a
# transaction the broker expires on its own deadline, with no command started.
exec 8> "$dir/ctl.$pid"
{ printf '%s %s\n' "$program" "$#"; printf '%s\0' "$PWD" "$@"; } >&8

# Opened by this shell, where the watchdog's signal lands, and handed to the readers below.
exec 3< "$dir/out.$pid" 4< "$dir/err.$pid"
stop_watchdog

# 3<&- 4<&- 8>&- 9>&-: the jobs outlive an interrupt that kills only this shell, and holding its
# ctl or lock descriptor would stall the cancel, or the next command, until the broker ends them.
cat <&3 3<&- 4<&- 8>&- 9>&- &
# HotSpot prints this banner with no option to suppress it, so the relay filters it out.
# RunOnHostSandbox.commandEnvironment explains why the commands need _JAVA_OPTIONS.
# -a: one NUL byte on stderr would otherwise make grep call the stream binary and print none of it.
# --line-buffered: grep block-buffers to a pipe, holding the command's stderr back by a bufferful.
# Unterminated stderr waits for a newline or EOF, even with --line-buffered.
grep -a --line-buffered -v '^Picked up _JAVA_OPTIONS: ' <&4 3<&- 4<&- 8>&- 9>&- >&2 &
exec 3<&- 4<&-
wait
# Bounded because with a live broker the exit code follows the drained output within
# milliseconds; only a broker that died mid-command leaves this FIFO unwritten, and hanging on it
# would turn that death into a command that never returns.
# `|| true`: a timed-out substitution would otherwise trip set -e before the diagnostic below.
code=$(timeout "$bound" cat "$dir/exit.$pid" 8>&- 9>&- || true)
[ -n "$code" ] || {
  echo "sandbox-run-on-host: the host side stopped answering; the command may still be" \
    "running — report this to the user" >&2
  exit 70
}
exit "$code"
