#!/usr/bin/env python3
"""
Asks this session's egress proxy about one host, from inside the sandbox. The script is the in-session twin of
the launcher's --egress-check=<host>, and it asks the running proxy instead of a one-shot proxy.

    ko-sandbox-egress-check <host>

The script sends one CONNECT <host>:443 to $HTTPS_PROXY. The proxy refuses with a 403 whose body names the reason
and the next step. Clients discard the body of a failed CONNECT, which is why this script exists.
- On a refusal, the script prints the response's Proxy-Status field, which carries the proxy's error type and is all
  that a response without a body says. The script then prints the body and exits 1.
- An allowed host gets one HEAD / inside TLS, trusting $SSL_CERT_FILE.
  - The proxy inspects some hosts and answers that HEAD itself when no line grants /. The script prints the proxy's
    status line and Proxy-Status, and a 403 exits 1. That answer has no body, because it answers a HEAD. The
    agent's own refused request gets the next step for its own path.
  - Otherwise the script prints the origin's status line and exits 0.
- A host that the ruleset allowed but the network failed prints what happened and exits 2. A 502 from the proxy and
  a TLS failure are such cases.
- Any other answer that the proxy makes itself exits 2 too, such as a 400 for a CONNECT it cannot parse or a 503 at
  its connection limit. Only a 403 is the ruleset's refusal.

Each run leaves in the audit log the line the agent's own program would have left: one deny, or one allow. The HEAD
names this script as its User-Agent, so that MeasurementReport tells the check from the agents' requests.
The script is Python rather than openssl or curl: Python's ssl module wraps a socket that already holds the tunnel,
which `openssl s_client` cannot do, and curl never shows the body of a failed CONNECT.
"""

import os
import socket
import ssl
import sys

NAME = "ko-sandbox-egress-check"
MAX_HEAD_BYTES = 16 * 1024
PROXY_STATUS_MEMBER = "ko-agent-egress-proxy"


def fail(message, code=2):
    print(f"{NAME}: {message}", file=sys.stderr)
    sys.exit(code)


def print_proxy_answer(request, status_line, headers, body_from=None):
    """Prints a response the proxy made itself, with its Proxy-Status field and any body. Exits 1 on a refusal and
    2 otherwise."""
    status = status_line.split(" ")[1] if status_line.count(" ") >= 2 else ""
    print(f"{request}: {status_line}")
    if "proxy-status" in headers:
        print(f"Proxy-Status: {headers['proxy-status']}")
    if body_from is not None:
        sys.stdout.write(read_body(body_from, headers))
    sys.exit(1 if status == "403" else 2)


def proxy_address():
    url = os.environ.get("HTTPS_PROXY", "")
    if not url.startswith("http://"):
        fail("HTTPS_PROXY is not an http:// URL, so there is no proxy to ask")
    host, _, port = url[len("http://"):].rstrip("/").rpartition(":")
    if not host or not port.isdigit():
        fail(f"HTTPS_PROXY={url} names no host:port")
    return host, int(port)


def read_head(sock):
    """Reads the response head up to its CRLF CRLF, bounded like the proxy's own reader."""
    head = b""
    while not head.endswith(b"\r\n\r\n"):
        chunk = sock.recv(1)
        if not chunk:
            raise EOFError("connection closed before the response head completed")
        head += chunk
        if len(head) > MAX_HEAD_BYTES:
            raise ValueError(f"response head exceeds {MAX_HEAD_BYTES} bytes")
    lines = head.decode("iso-8859-1").split("\r\n")
    headers = {}
    for line in lines[1:]:
        name, _, value = line.partition(":")
        if name:
            headers[name.strip().lower()] = value.strip()
    return lines[0], headers


def read_body(sock, headers):
    wanted = int(headers.get("content-length", "0") or "0")
    body = b""
    while len(body) < wanted:
        chunk = sock.recv(wanted - len(body))
        if not chunk:
            break
        body += chunk
    return body.decode("utf-8", "replace")


def main():
    if len(sys.argv) != 2 or sys.argv[1].startswith("-"):
        fail(f"usage: {NAME} <host>")
    try:
        host = sys.argv[1].encode("idna").decode("ascii")
    except UnicodeError as ex:
        fail(f"'{sys.argv[1]}' is not a hostname: {ex}")
    proxy_host, proxy_port = proxy_address()

    try:
        sock = socket.create_connection((proxy_host, proxy_port), timeout=30)
    except OSError as ex:
        fail(f"cannot reach the proxy at {proxy_host}:{proxy_port}: {ex}")

    with sock:
        try:
            sock.sendall(f"CONNECT {host}:443 HTTP/1.1\r\nHost: {host}:443\r\n\r\n".encode("ascii"))
            status_line, headers = read_head(sock)
        except (OSError, EOFError, ValueError) as ex:
            fail(f"CONNECT {host}:443: {ex}")
        status = status_line.split(" ")[1] if status_line.count(" ") >= 2 else ""

        if status != "200":
            print_proxy_answer(f"CONNECT {host}:443", status_line, headers, sock)

        # Past the 200 every failure is the network's, not the ruleset's: exit 2, never 1.
        try:
            context = ssl.create_default_context(cafile=os.environ.get("SSL_CERT_FILE"))
            tls = context.wrap_socket(sock, server_hostname=host)
        except (ssl.SSLError, OSError) as ex:
            print(f"CONNECT {host}:443: 200, then TLS failed: {ex}")
            sys.exit(2)
        with tls:
            try:
                head = f"HEAD / HTTP/1.1\r\nHost: {host}\r\nUser-Agent: {NAME}\r\nConnection: close\r\n\r\n"
                tls.sendall(head.encode("ascii"))
                origin_status, origin_headers = read_head(tls)
                # An informational response (103 Early Hints) precedes the final one.
                while origin_status.split(" ")[1:2] and origin_status.split(" ")[1].startswith("1"):
                    origin_status, origin_headers = read_head(tls)
                if origin_headers.get("proxy-status", "").split(";")[0].strip() == PROXY_STATUS_MEMBER:
                    print_proxy_answer(f"CONNECT {host}:443: 200; HEAD /", origin_status, origin_headers)
            except (OSError, EOFError, ValueError) as ex:
                print(f"CONNECT {host}:443: 200, then HEAD / failed: {ex}")
                sys.exit(2)
        print(f"CONNECT {host}:443: 200; HEAD / -> {origin_status}")


main()
