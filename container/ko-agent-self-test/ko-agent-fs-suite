#!/bin/sh
# The launcher's `--self-test` runs this script inside the self-test image (ko-agent-fs/doc/testing.md).
set -eu

suite=/opt/ko-agent-fs-suite

echo "machine: $(uname -srm), uid $(id -u)"

# The FUSE backend's own setup check runs first. --self-test mounts with the product's options, allow_other among them,
# so it is the only check here that exercises what user_allow_other permits.
# - The check grades its own failure by the stage it reached. The check exits 3 for anything before its behavioral
#   checks begin, the scratch tree and the mount alike, and the launcher answers exit 3 by retrying with more privilege.
#   The check exits 1 for anything past that stage, which no machine or privilege change repairs.
# - mount_probe cannot serve as this check: it mounts with fuser's defaults, so an allow_other refusal passes it and
#   appears later as an apparent defect.
selftest=0
"$suite/ko-agent-fs-fuse" --self-test || selftest=$?
[ "$selftest" -ne 3 ] || exit 3

# Past the mount, the self-test is a check like any other: the policy refusing a .git entry, and a host write
# reaching both a cached read and an established mapping.
status=0
[ "$selftest" -eq 0 ] || status=1

# --include-ignored, not --ignored: the image build runs neither half (ko-agent-fs/Containerfile), so this container
# runs all of the tests.
# Each binary prints its own counts, so a summary repeats them at the end, where a reader need not scroll for them.
if [ "$selftest" -eq 0 ]; then verdict=PASS failing=0; else verdict=FAIL failing=1; fi
summary="  $verdict  ko-agent-fs-fuse --self-test"
passed=0
failed=0
rows=1
out=$(mktemp)
for binary in "$suite"/deps/*; do
    # The image names each binary <package>:<kind>:<target> (Containerfile).
    name=$(printf %s "${binary##*/}" | tr : ' ')
    echo "== $name"
    # `&& ... ||` keeps set -e from ending the group before it records the status.
    { "$binary" --include-ignored && echo 0 >"$out.exit" || echo $? >"$out.exit"; } | tee "$out"
    counts=$(sed -n 's/^test result: [a-zA-Z]*\. \([0-9]*\) passed; \([0-9]*\) failed;.*/\1 \2/p' "$out" | tail -n 1)
    rows=$((rows + 1))
    if [ "$(cat "$out.exit")" -eq 0 ] && [ -n "$counts" ]; then
        verdict=PASS
    else
        verdict=FAIL
        status=1
        failing=$((failing + 1))
    fi
    if [ -n "$counts" ]; then
        passed=$((passed + ${counts% *}))
        failed=$((failed + ${counts#* }))
        detail="${counts% *} passed, ${counts#* } failed"
    else
        detail="exit $(cat "$out.exit") without a result line"
    fi
    summary="$summary
$(printf '  %s  %-58s %s' "$verdict" "$name" "$detail")"
done
rm -f "$out" "$out.exit"

echo
# The rows count beside the tests, because a binary that crashes and a failed --self-test add no failed test.
echo "suite summary: $passed tests passed, $failed failed; $failing of $rows rows failed"
echo "$summary"
exit $status
