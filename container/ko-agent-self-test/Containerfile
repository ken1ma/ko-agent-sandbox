# ---------------------------------------------------------------------------
# Build ko-agent-self-test
# ---------------------------------------------------------------------------
#
# The launcher's `--self-test` runs the ko-agent-fs workspace's suites in this container
# (`ko-agent-fs/doc/testing.md`).
# - The suites' mounted half needs /dev/fuse and CAP_SYS_ADMIN, which no image build has, so the suites compile here
#   and run later. `--no-run` in the builder means that verification compiles nothing and fetches nothing.
# - The launcher's `--self-test` also builds the image (ImageBuilds.selfTestBuildCommands).
#
# The context is the unpacked bundle root rather than this directory, because the workspace to compile is beside
# this directory. RUST_VERSION has no default here: it is the version that ko-agent-fs/Containerfile pins, passed in
# by whoever builds, so this image cannot drift into exercising a second compiler.

ARG RUST_VERSION
FROM docker.io/library/rust:${RUST_VERSION}-slim-trixie AS build

# musl-tools supplies musl-gcc, which the musl target needs to link.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends musl-tools; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; rustup target add "$(uname -m)-unknown-linux-musl"

WORKDIR /build
COPY ko-agent-fs .

# The identity that the installed binaries report. The suites run against the same source that the launcher bundles,
# so the digest travels here too rather than stay unstamped.
ARG KO_AGENT_FS_SOURCE_ID=unstamped
ENV KO_AGENT_FS_SOURCE_ID=${KO_AGENT_FS_SOURCE_ID}

# The build uses the shipping triple, for the reason ko-agent-fs/Containerfile builds with it: a glibc build cannot
# show the static-musl link constraint that fuse/src/fs.rs records at its rename.
#
# - The RUN writes the artifacts in the layout that each tests/binary.rs resolves by, reproduced rather than
#   flattened: <dir>/deps/<test> beside <dir>/ko-agent-fs and <dir>/ko-agent-fs-fuse.
# - `--message-format=json` names each executable. Guessing at hash-suffixed filenames would silently miss a test
#   target added later.
# - A cache mount is not a layer, so the RUN lifts the artifacts out of the mount.
# - The mounts are the ones that ko-agent-fs/Containerfile's build step uses, and that file says what the locks and
#   expire-build-cache.sh are for.
RUN --mount=type=cache,target=/build/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    set -eux; \
    exec 8</build/target 9</usr/local/cargo/registry; \
    flock 8; \
    flock 9; \
    sh expire-build-cache.sh /build/target /usr/local/cargo/registry; \
    triple="$(uname -m)-unknown-linux-musl"; \
    mkdir -p /suite/deps; \
    cargo test --locked --no-run --target "${triple}" --message-format=json > /tmp/artifacts.json; \
    grep -o '"executable":"[^"]*"' /tmp/artifacts.json \
        | sed 's/^"executable":"//; s/"$//' \
        | while read -r artifact; do \
            case "${artifact}" in \
                */deps/*) install -m 0755 "${artifact}" /suite/deps/ ;; \
                *) install -m 0755 "${artifact}" /suite/ ;; \
            esac; \
        done; \
    # The pipeline above runs its loop in a subshell, so these tests are what actually fail the build.
    test -x /suite/ko-agent-fs; \
    test -x /suite/ko-agent-fs-fuse; \
    test -n "$(ls /suite/deps)"

# The BPF classifier's host build, which policy/tests/bpf_equivalence.rs runs. It compiles here, where a C compiler
# and the sources are. KO_AGENT_FS_POLICY_HOST below names it to the test, since the test's own build looks for the
# sources beside the package, and the runtime image lacks them.
RUN set -eux; \
    cc -std=gnu17 -O1 -Wall -I /build/bpf/test/host -I /build/policy/include -o /suite/policy-host \
        /build/bpf/test/host/policy_host.c /build/bpf/test/host/records_file.c; \
    test -x /suite/policy-host


# The base is the sandbox image for two reasons beyond convenience: it is already on the user's machine, so verifying
# pulls nothing, and it carries `git`, which fuse/tests/mounted_git.rs needs and a podman machine lacks. The sandbox
# image's `nonroot` user is the third reason; see the fuse3 step below.
FROM ko-agent-sandbox:latest

USER root

# fuse3 supplies fusermount3.
# - An unprivileged uid holds no effective CAP_SYS_ADMIN and so cannot mount(2). The mount takes the setuid helper
#   instead, which is the route a real session takes, and one that the dev rig running as root never reaches.
# - Podman keeps SYS_ADMIN in the bounding set for a non-root USER, so the helper can reach it
#   (ko-agent-fs/fuse/doc/verification-log.md). The launcher retries as root if some machine ever does not keep it.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends fuse3; \
    rm -rf /var/lib/apt/lists/*; \
    # The suites mount with the product's options, allow_other among them, which fusermount3 refuses without this
    # line. The build writes the line into the image rather than at runtime, so verifying never touches the podman
    # machine's own /etc/fuse.conf.
    echo user_allow_other >> /etc/fuse.conf

COPY --from=build /suite /opt/ko-agent-fs-suite
COPY ko-agent-self-test/ko-agent-fs-suite /usr/local/bin/ko-agent-fs-suite
RUN chmod 0755 /usr/local/bin/ko-agent-fs-suite
ENV KO_AGENT_FS_POLICY_HOST=/opt/ko-agent-fs-suite/policy-host

USER nonroot
ENTRYPOINT ["/usr/local/bin/ko-agent-fs-suite"]
