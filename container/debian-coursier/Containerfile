ARG IMG_TAG_VER
FROM debian-temurin:${IMG_TAG_VER}

# Coursier, from https://get-coursier.io/docs/cli-installation — latest
# rather than stable, intentionally. Installs to the default ~/.local/share
# path: this is a development environment.
USER nonroot
RUN set -euxo pipefail; \
    curl -fsSL "https://github.com/coursier/launchers/raw/master/cs-$(uname -m)-pc-linux.gz" | gzip -d > /tmp/cs; \
    chmod 0755 /tmp/cs; \
    # cs setup detects the Temurin installed in the parent image; `--env` avoids updating `.profile`.
    # Select coursier's default apps except two redundant launchers.
    # Omit `scala-cli`: the Scala distribution behind `scala` bundles the same Scala CLI native image.
    # Omit `coursier`: it is the JAR-based fallback; both architecture builds install a native `cs`.
    /tmp/cs setup --yes --env --apps cs,scala,scalac,sbt,sbtn,scalafmt; \
    rm /tmp/cs

# Make `apt-get install` usable again; descendant images set `USER nonroot` themselves
USER root

# Modify `PATH` since `$HOME/.profile` will not be sourced by `podman run --rm -it image bash`
ENV PATH="/home/nonroot/.local/share/coursier/bin:$PATH"


# Known problem: `cs java --installed` OOMs (memory.events shows oom_kill).
# A Coursier JVM-index problem — the JVM-based coursier launcher also throws
# OutOfMemoryError even with a 2GB heap.
