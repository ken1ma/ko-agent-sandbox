# The curated restricted catalog: what deny-unless-allowed admits on its own. Every entry is
# TLS-inspected, GET and HEAD only, plus its allowance's one POST; SECURITY.md, "Reading without
# being able to write", has what each allowance opens and what the inspection costs and buys.

# git hosts
+host github.com                     allow=git-fetch
+host raw.githubusercontent.com      allow=git-fetch
+host objects.githubusercontent.com  allow=git-fetch
+host codeload.github.com            allow=git-fetch
+host api.github.com                 allow=git-fetch
+host codeberg.org                   allow=git-fetch
+host gitlab.com                     allow=git-fetch

# GitHub content, served as pre-signed GETs; no allowance, like the doc sites — no
# git-upload-pack endpoint lives on them
+host release-assets.githubusercontent.com  # release downloads
+host media.githubusercontent.com           # LFS files, one URL per file

# the agent docs
+host code.claude.com        # claude
+host developers.openai.com  # codex
+host antigravity.google     # agy
+host docs.github.com        # copilot

# public documents / repositories
+host www.rfc-editor.org
+host www.w3.org
+host developer.mozilla.org  # HTTP / HTML / CSS / JavaScript / Web APIs
# WHATWG specs are per-spec subdomains; a project adds the exact host it reads
# (+host html.spec.whatwg.org)

