# Antigravity. Signed in with a Google account, model traffic and account state go to one of the
# two hosts below by account kind; daily-cloudcode-pa is a production endpoint despite its name.
# Google's Code Assist page names cloudcode-pa, "an internal API that provides IDE-related
# features": https://docs.cloud.google.com/gemini/docs/codeassist/set-up-gemini
# No page read names daily-cloudcode-pa or the split; agy's own log under
# ~/.gemini/antigravity-cli/log/ shows it after a consumer sign-in.
# The Business and API-key modes below are agy's changelog entries 1.1.10 and 1.1.13:
# https://github.com/google-antigravity/antigravity-cli/blob/main/CHANGELOG.md
allow https://cloudcode-pa.googleapis.com/        tunnel  # GCP-licensed accounts
allow https://daily-cloudcode-pa.googleapis.com/  tunnel  # consumer accounts: AI Pro/Ultra/One/Free

# GEMINI_API_KEY, the Gemini API with no sign-in: https://antigravity.google/docs/cli/install
allow https://generativelanguage.googleapis.com/  tunnel

# Business sign-in with a Gemini Enterprise license in a Google Cloud project uses the Business AI
# Code API (license, configuration, generateContent) and the Agent Platform API the enterprise doc
# has the project enable, at the host of the license's location: `global`, `us` or `eu`, the doc's
# whole choice: https://antigravity.google/docs/enterprise
# Business AI Code "provides AI-powered code generation for Antigravity in Gemini Enterprise":
# https://docs.cloud.google.com/gemini/enterprise/docs/ai-developer-tools-settings
# The multi-region hosts: https://docs.cloud.google.com/vertex-ai/generative-ai/docs/learn/locations
# SECURITY.md, "Not defended", has what the aiplatform tunnels open to the credential.
# Advanced WIF sign-in's token exchange, at sts.googleapis.com and iamcredentials.googleapis.com,
# is a project's own setup, added in .ko-agent-sandbox/egress/rule when the proxy's 403 names it.
allow https://businessaicode.googleapis.com/      tunnel
allow https://aiplatform.googleapis.com/          tunnel  # global
allow https://aiplatform.us.rep.googleapis.com/   tunnel  # us
allow https://aiplatform.eu.rep.googleapis.com/   tunnel  # eu

# Google-account sign-in, consumer and Business alike.
allow https://accounts.google.com/                tunnel  # printed sign-in URL
allow https://oauth2.googleapis.com/              tunnel  # code exchange and token refresh

# play.googleapis.com — telemetry and experiment polling — is absent, as ab.chatgpt.com is in
# model-provider/openai.
